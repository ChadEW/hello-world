//@version=6
// =====================================================================
//  ICC_TradesBySci_v3.1.pine  —  COMBINED INDICATOR
//  Sci swing rays + body-close S/R + cascade dashboard
//  + broken-level handling + retest state
//  + FLASHING entry/exit dialog boxes (with Entry / SL / TP prices)
//  + NEW v3.1: RETEST-CONFIRMATION ENTRIES
//      A broken level that is retested from the other side and then
//      REJECTS (closes back in the break direction) fires a real
//      BUY/SELL signal — the classic broken-S/R-becomes-opposite play.
//  Built for Chad Woodyard, July 2026.  v6 wrap-hardened.
// =====================================================================
indicator("ICC TradesBySci v3.1 (Combined)", "ICC-Sci v3.1", overlay = true,
     max_lines_count  = 500,
     max_labels_count = 500,
     max_boxes_count  = 500)

// ============================ INPUTS: Swings =========================
grpSw     = "Swing / Structure (Sci style)"
swingLen  = input.int(5,    "Swing pivot length (bars L/R)", minval = 2, group = grpSw)
showSwings= input.bool(true,"Draw swing high/low rays",       group = grpSw)
maxSwings = input.int(6,    "Max recent swing lines kept",    minval = 1, maxval = 30, group = grpSw)
colHigh   = input.color(color.new(#1E88E5, 0), "Swing High (sellers' line)", group = grpSw)
colLow    = input.color(color.new(#E53935, 0), "Swing Low (buyers' line)",   group = grpSw)

// ============================ INPUTS: Cascade =======================
grpTF     = "Timeframe Cascade (D1 -> H4 -> H1 -> M15)"
biasTF    = input.timeframe("D",    "Top bias TF (Indication)",  group = grpTF)
midTF     = input.timeframe("240",  "Mid TF (Correction map)",   group = grpTF)
workTF    = input.timeframe("60",   "Working TF (Continuation)", group = grpTF)
trigTF    = input.timeframe("15",   "Trigger TF (Entry timing)", group = grpTF)
strictAlign = input.bool(true, "Require ALL four TFs to agree", group = grpTF)
cascadeSwingLen = input.int(5, "Cascade pivot length (bars L/R)", minval = 2, group = grpTF)
showDash  = input.bool(true, "Show cascade dashboard", group = grpTF)

// ============================ INPUTS: S/R ===========================
grpSR     = "Support / Resistance (body-close levels)"
srShow    = input.bool(true,  "Show body-close S/R levels",              group = grpSR)
srMinTouch= input.int(3,      "Min body closes to confirm a level",       minval = 2, group = grpSR)
srTolPips = input.float(10.0, "Zone tolerance (pips)",                    minval = 0.1, step = 0.5, group = grpSR)
srDurMode = input.string("Calendar Days", "Level duration unit", options = ["Calendar Days", "Trading Sessions"], group = grpSR)
srDurN    = input.int(3,      "Level duration (days or sessions)",        minval = 1, group = grpSR)
srColRes  = input.color(color.new(color.orange, 0), "Resistance color",  group = grpSR)
srColSup  = input.color(color.new(color.teal,   0), "Support color",     group = grpSR)
srUseZone = input.bool(true,  "Draw as shaded zone (box) instead of line",group = grpSR)
srShowCnt = input.bool(true,  "Show touch-count label",                  group = grpSR)
srRefLen  = input.int(20,     "Reference SMA length (S/R classifier)",    minval = 5, group = grpSR)

// ============================ INPUTS: Broken level ==================
grpBrk    = "Broken-Level Behavior"
brkMode   = input.string("Gray Out", "When a level is broken", options = ["Gray Out", "Delete"], group = grpBrk, tooltip = "A level breaks when a candle body CLOSES beyond it by the break buffer.")
brkBufPips= input.float(2.0, "Break buffer beyond level (pips)", minval = 0.0, step = 0.5, group = grpBrk)
brkColor  = input.color(color.new(color.gray, 40), "Grayed-out color", group = grpBrk)

// ============================ INPUTS: Flash box =====================
grpFlash  = "Entry / Exit Flashing Dialog"
flashOn   = input.bool(true, "Show flashing entry/exit dialog box", group = grpFlash)
flashBars = input.int(4, "Flash duration (bars)", minval = 1, maxval = 30, group = grpFlash)
flashPos  = input.string("Middle Center", "Box position", options = ["Middle Center","Top Center","Bottom Center"], group = grpFlash)
flashRR   = input.float(2.0, "TP reward:risk (for price display)", minval = 0.1, step = 0.1, group = grpFlash)
showFlashPrices = input.bool(true, "Show Entry / SL / TP prices in the box", group = grpFlash)
colBuy    = input.color(color.new(color.lime, 0),  "BUY box color",  group = grpFlash)
colSell   = input.color(color.new(color.red,  0),  "SELL box color", group = grpFlash)
colExit   = input.color(color.new(color.orange,0), "EXIT box color", group = grpFlash)

// ============================ INPUTS: Retest ========================
grpRetest = "Retest Flash + Confirmation Entry"
retestOn  = input.bool(true, "Flash a small RETEST box on broken-level return", group = grpRetest)
retestBars= input.int(3, "Retest flash duration (bars)", minval = 1, maxval = 20, group = grpRetest)
colRetest = input.color(color.new(color.yellow, 0), "RETEST box color", group = grpRetest)
// --- NEW: retest-confirmation entry ---
retestEntryOn = input.bool(true, "Fire ENTRY when a retest REJECTS (break direction)", group = grpRetest, tooltip = "Broken resistance held from below -> BUY; broken support held from above -> SELL.")
retestConfBufPips = input.float(1.0, "Rejection confirmation buffer (pips)", minval = 0.0, step = 0.5, group = grpRetest, tooltip = "How far beyond the level the confirming candle must CLOSE (back in the break direction).")
retestArmBars = input.int(5, "Arm window (bars) after a retest", minval = 1, maxval = 50, group = grpRetest, tooltip = "The rejection must confirm within this many bars of the retest, else the setup is disarmed.")
retestSepBar  = input.bool(true, "Require a separate confirmation bar (not the retest bar itself)", group = grpRetest)
retestSLbufPips = input.float(3.0, "Retest SL buffer beyond level (pips)", minval = 0.0, step = 0.5, group = grpRetest)
colRBuy   = input.color(color.new(color.green, 0), "RETEST BUY box color",  group = grpRetest)
colRSell  = input.color(color.new(color.maroon,0), "RETEST SELL box color", group = grpRetest)

// ============================ PIP / TOL =============================
isForex = str.contains(syminfo.type, "forex")
pip     = syminfo.mintick * (isForex ? 10 : 1)
srTol   = srTolPips * pip
brkBuf  = brkBufPips * pip
confBuf = retestConfBufPips * pip
slBuf   = retestSLbufPips * pip

// ============================ SESSION COUNTER =======================
var int sessCount = 0
dayChange = ta.change(time("D"))
if not na(dayChange) and dayChange != 0
    sessCount += 1

srRef = ta.sma(close, srRefLen)

// ============================ CASCADE BIAS ENGINE ===================
f_bias(_tf) =>
    [ph1, pl1] = request.security(syminfo.tickerid, _tf, [ta.pivothigh(cascadeSwingLen, cascadeSwingLen), ta.pivotlow(cascadeSwingLen, cascadeSwingLen)], lookahead = barmerge.lookahead_off)
    var float lastH1 = na
    var float prevH1 = na
    var float lastL1 = na
    var float prevL1 = na
    if not na(ph1)
        prevH1 := lastH1
        lastH1 := ph1
    if not na(pl1)
        prevL1 := lastL1
        lastL1 := pl1
    haveAll = not na(lastH1) and not na(prevH1) and not na(lastL1) and not na(prevL1)
    bull    = haveAll and lastH1 > prevH1 and lastL1 > prevL1
    bear    = haveAll and lastH1 < prevH1 and lastL1 < prevL1
    b = bull ? 1 : bear ? -1 : 0
    b

biasD1 = f_bias(biasTF)
biasH4 = f_bias(midTF)
biasH1 = f_bias(workTF)
biasM15= f_bias(trigTF)

strictBull = biasD1 ==  1 and biasH4 ==  1 and biasH1 ==  1 and biasM15 ==  1
looseBull  = biasH1 ==  1 and biasM15 ==  1
strictBear = biasD1 == -1 and biasH4 == -1 and biasH1 == -1 and biasM15 == -1
looseBear  = biasH1 == -1 and biasM15 == -1
alignBull  = strictAlign ? strictBull : looseBull
alignBear  = strictAlign ? strictBear : looseBear

// ============================ WORKING-TF SWINGS =====================
var float wkLastHi = na
var float wkLastLo = na
wkHi = request.security(syminfo.tickerid, workTF, ta.pivothigh(cascadeSwingLen, cascadeSwingLen), lookahead = barmerge.lookahead_off)
wkLo = request.security(syminfo.tickerid, workTF, ta.pivotlow (cascadeSwingLen, cascadeSwingLen), lookahead = barmerge.lookahead_off)
if not na(wkHi)
    wkLastHi := wkHi
if not na(wkLo)
    wkLastLo := wkLo

trigClose = request.security(syminfo.tickerid, trigTF, close, lookahead = barmerge.lookahead_off)

// ============================ SWING RAYS ============================
phSwing = ta.pivothigh(swingLen, swingLen)
plSwing = ta.pivotlow (swingLen, swingLen)

var line[] swLines = array.new<line>()

f_pushSwing(px, col) =>
    ln = line.new(bar_index[swingLen], px, bar_index, px, color = col, width = 2, extend = extend.right, style = line.style_solid)
    array.push(swLines, ln)
    while array.size(swLines) > maxSwings * 2
        line.delete(array.shift(swLines))

if showSwings and not na(phSwing)
    f_pushSwing(high[swingLen], colHigh)
if showSwings and not na(plSwing)
    f_pushSwing(low[swingLen], colLow)

// ============================ S/R CLUSTER STORE =====================
var float[] srPrice   = array.new_float()
var int[]   srCount   = array.new_int()
var int[]   srBirthMs = array.new_int()
var int[]   srBirthSes= array.new_int()
var int[]   srBirthBar= array.new_int()
var bool[]  srIsRes   = array.new_bool()
var bool[]  srDrawn   = array.new_bool()
var bool[]  srBroken  = array.new_bool()
var bool[]  srRetested= array.new_bool()
var bool[]  srArmed   = array.new_bool()
var int[]   srArmBar  = array.new_int()
var line[]  srLine    = array.new<line>()
var box[]   srBox     = array.new<box>()
var label[] srLbl     = array.new<label>()

f_srExpired(i) =>
    exp = false
    if srDurMode == "Calendar Days"
        exp := (time - array.get(srBirthMs, i)) >= srDurN * 86400000
    else
        exp := (sessCount - array.get(srBirthSes, i)) >= srDurN
    exp

f_srRemove(i) =>
    ln = array.get(srLine, i)
    if not na(ln)
        line.delete(ln)
    bx = array.get(srBox, i)
    if not na(bx)
        box.delete(bx)
    lb = array.get(srLbl, i)
    if not na(lb)
        label.delete(lb)
    array.remove(srPrice, i)
    array.remove(srCount, i)
    array.remove(srBirthMs, i)
    array.remove(srBirthSes, i)
    array.remove(srBirthBar, i)
    array.remove(srIsRes, i)
    array.remove(srDrawn, i)
    array.remove(srBroken, i)
    array.remove(srRetested, i)
    array.remove(srArmed, i)
    array.remove(srArmBar, i)
    array.remove(srLine, i)
    array.remove(srBox, i)
    array.remove(srLbl, i)

f_srLabelText(isRes, cnt, broken) =>
    pre = broken ? "x " : ""
    pre + (isRes ? "R x" : "S x") + str.tostring(cnt)

f_srDraw(i) =>
    p     = array.get(srPrice, i)
    isRes = array.get(srIsRes, i)
    col   = isRes ? srColRes : srColSup
    bBar  = array.get(srBirthBar, i)
    if srUseZone
        bx = box.new(bBar, p + srTol / 2, bar_index, p - srTol / 2, border_color = col, bgcolor = color.new(col, 82))
        array.set(srBox, i, bx)
    else
        ln = line.new(bBar, p, bar_index, p, color = col, width = 2, style = line.style_solid)
        array.set(srLine, i, ln)
    if srShowCnt
        lblStyle = isRes ? label.style_label_down : label.style_label_up
        lb = label.new(bar_index, p, f_srLabelText(isRes, array.get(srCount, i), false), style = lblStyle, color = col, textcolor = color.white, size = size.tiny)
        array.set(srLbl, i, lb)

f_srBreak(i) =>
    if brkMode == "Delete"
        f_srRemove(i)
    else
        array.set(srBroken, i, true)
        ln = array.get(srLine, i)
        if not na(ln)
            line.set_color(ln, brkColor)
            line.set_style(ln, line.style_dashed)
        bx = array.get(srBox, i)
        if not na(bx)
            box.set_border_color(bx, brkColor)
            box.set_bgcolor(bx, color.new(brkColor, 88))
        lb = array.get(srLbl, i)
        if not na(lb)
            isRes = array.get(srIsRes, i)
            label.set_color(lb, brkColor)
            label.set_text(lb, f_srLabelText(isRes, array.get(srCount, i), true))

// ============================ S/R ENGINE (confirmed bars) ===========
var bool  srBrokeThisBar   = false
var bool  srRetestThisBar  = false
var bool  srRetestIsRes    = false
// NEW retest-confirmation signal outputs
var bool  retestBuySig     = false
var bool  retestSellSig    = false
var float retestSigLevel   = na
srBrokeThisBar  := false
srRetestThisBar := false
retestBuySig    := false
retestSellSig   := false

if barstate.isconfirmed and srShow
    c = close

    // 1) expire old levels
    if array.size(srPrice) > 0
        for i = array.size(srPrice) - 1 to 0
            if f_srExpired(i)
                f_srRemove(i)

    // 2) broken-level check
    if array.size(srPrice) > 0
        for i = array.size(srPrice) - 1 to 0
            if array.get(srDrawn, i) and not array.get(srBroken, i)
                lvl   = array.get(srPrice, i)
                isRes = array.get(srIsRes, i)
                brokeUp   = isRes and c > lvl + brkBuf
                brokeDown = (not isRes) and c < lvl - brkBuf
                if brokeUp or brokeDown
                    srBrokeThisBar := true
                    f_srBreak(i)

    // 2b) retest check on BROKEN, not-yet-retested levels (Gray Out mode only)
    if brkMode == "Gray Out" and array.size(srPrice) > 0
        for i = array.size(srPrice) - 1 to 0
            if array.get(srBroken, i) and not array.get(srRetested, i)
                lvl   = array.get(srPrice, i)
                isRes = array.get(srIsRes, i)
                retRes = isRes and low <= lvl + brkBuf and close >= lvl - brkBuf
                retSup = (not isRes) and high >= lvl - brkBuf and close <= lvl + brkBuf
                if retRes or retSup
                    array.set(srRetested, i, true)
                    array.set(srArmed, i, true)
                    array.set(srArmBar, i, bar_index)
                    srRetestThisBar := true
                    srRetestIsRes   := isRes

    // 2c) NEW: retest-confirmation entry — armed level REJECTS in break dir
    if retestEntryOn and array.size(srPrice) > 0
        for i = array.size(srPrice) - 1 to 0
            if array.get(srArmed, i)
                lvl    = array.get(srPrice, i)
                isRes  = array.get(srIsRes, i)
                armAge = bar_index - array.get(srArmBar, i)
                if armAge > retestArmBars
                    array.set(srArmed, i, false)
                else
                    canCheck = retestSepBar ? (armAge >= 1) : (armAge >= 0)
                    if canCheck
                        // broken resistance now support -> close back ABOVE = BUY
                        confBuy  = isRes and close > lvl + confBuf
                        // broken support now resistance -> close back BELOW = SELL
                        confSell = (not isRes) and close < lvl - confBuf
                        if confBuy
                            array.set(srArmed, i, false)
                            retestBuySig  := true
                            retestSigLevel:= lvl
                        else if confSell
                            array.set(srArmed, i, false)
                            retestSellSig := true
                            retestSigLevel:= lvl

    // 3) match this close to an existing cluster (skip broken ones)
    matched = false
    if array.size(srPrice) > 0
        for i = 0 to array.size(srPrice) - 1
            if not array.get(srBroken, i) and math.abs(c - array.get(srPrice, i)) <= srTol
                nc = array.get(srCount, i) + 1
                np = (array.get(srPrice, i) * array.get(srCount, i) + c) / nc
                array.set(srCount, i, nc)
                array.set(srPrice, i, np)
                matched := true
                alreadyDrawn = array.get(srDrawn, i)
                if nc == srMinTouch and not alreadyDrawn
                    array.set(srDrawn, i, true)
                    array.set(srIsRes, i, np >= srRef)
                    f_srDraw(i)
                else if nc > srMinTouch and alreadyDrawn and srShowCnt
                    lb = array.get(srLbl, i)
                    if not na(lb)
                        isRes = array.get(srIsRes, i)
                        label.set_text(lb, f_srLabelText(isRes, nc, false))
                        label.set_xy(lb, bar_index, np)
                break

    // 4) no match -> new candidate cluster
    if not matched
        array.push(srPrice, c)
        array.push(srCount, 1)
        array.push(srBirthMs, time)
        array.push(srBirthSes, sessCount)
        array.push(srBirthBar, bar_index)
        array.push(srIsRes, false)
        array.push(srDrawn, false)
        array.push(srBroken, false)
        array.push(srRetested, false)
        array.push(srArmed, false)
        array.push(srArmBar, 0)
        array.push(srLine, na)
        array.push(srBox, na)
        array.push(srLbl, na)
        if array.size(srPrice) > 60
            f_srRemove(0)

// 5) extend active (drawn, not broken) levels to current bar
if srShow and array.size(srPrice) > 0
    for i = 0 to array.size(srPrice) - 1
        if array.get(srDrawn, i) and not array.get(srBroken, i)
            ln = array.get(srLine, i)
            if not na(ln)
                line.set_x2(ln, bar_index)
            bx = array.get(srBox, i)
            if not na(bx)
                box.set_right(bx, bar_index)

// =====================================================================
//  CASCADE ENTRY / EXIT SIGNALS
// =====================================================================
buyContinuation  = alignBull and not na(wkLastHi) and trigClose > wkLastHi
sellContinuation = alignBear and not na(wkLastLo) and trigClose < wkLastLo

cascBuySig  = buyContinuation  and not buyContinuation[1]
cascSellSig = sellContinuation and not sellContinuation[1]

// Combine cascade + retest entries (retest is an additional entry path)
buySig  = cascBuySig  or retestBuySig
sellSig = cascSellSig or retestSellSig

// =====================================================================
//  VIRTUAL POSITION + EXIT DETECTION
// =====================================================================
var int   posDir  = 0        // 1 long, -1 short, 0 flat
var float posSLan = na       // SL anchor recorded at entry

// SL anchors for the two entry types
buySLcasc  = wkLastLo
sellSLcasc = wkLastHi
buySLretest  = na(retestSigLevel) ? wkLastLo : retestSigLevel - slBuf
sellSLretest = na(retestSigLevel) ? wkLastHi : retestSigLevel + slBuf

exitLong  = false
exitShort = false
if barstate.isconfirmed
    if posDir == 1
        if sellSig or (not na(posSLan) and close < posSLan)
            exitLong := true
            posDir   := 0
            posSLan  := na
    if posDir == -1
        if buySig or (not na(posSLan) and close > posSLan)
            exitShort := true
            posDir    := 0
            posSLan   := na
    // entries when flat — retest takes priority if both fire same bar
    if posDir == 0 and buySig
        posDir  := 1
        posSLan := retestBuySig ? buySLretest : buySLcasc
    else if posDir == 0 and sellSig
        posDir  := -1
        posSLan := retestSellSig ? sellSLretest : sellSLcasc

// =====================================================================
//  FLASHING ENTRY / EXIT DIALOG BOX (with Entry / SL / TP prices)
// =====================================================================
var int    flashLeft  = 0
var string flashMsg   = ""
var color  flashBase  = color.gray
var float  flashEntry = na
var float  flashSL    = na
var float  flashTP    = na
var bool   flashHasPx = false

f_px(v) => str.tostring(v, format.mintick)

if barstate.isconfirmed
    // retest entries first (higher priority / clearer message)
    if retestBuySig
        flashLeft  := flashBars
        flashMsg   := "RETEST  BUY"
        flashBase  := colRBuy
        flashEntry := close
        flashSL    := buySLretest
        flashTP    := close + (close - buySLretest) * flashRR
        flashHasPx := true
    else if retestSellSig
        flashLeft  := flashBars
        flashMsg   := "RETEST  SELL"
        flashBase  := colRSell
        flashEntry := close
        flashSL    := sellSLretest
        flashTP    := close - (sellSLretest - close) * flashRR
        flashHasPx := true
    else if cascBuySig
        flashLeft  := flashBars
        flashMsg   := "BUY  ENTRY"
        flashBase  := colBuy
        flashEntry := close
        flashSL    := wkLastLo
        flashTP    := close + (close - wkLastLo) * flashRR
        flashHasPx := true
    else if cascSellSig
        flashLeft  := flashBars
        flashMsg   := "SELL  ENTRY"
        flashBase  := colSell
        flashEntry := close
        flashSL    := wkLastHi
        flashTP    := close - (wkLastHi - close) * flashRR
        flashHasPx := true
    else if exitLong
        flashLeft  := flashBars
        flashMsg   := "EXIT  LONG"
        flashBase  := colExit
        flashHasPx := false
    else if exitShort
        flashLeft  := flashBars
        flashMsg   := "EXIT  SHORT"
        flashBase  := colExit
        flashHasPx := false
    else if flashLeft > 0
        flashLeft := flashLeft - 1

f_flashYpos() =>
    flashPos == "Top Center" ? position.top_center : flashPos == "Bottom Center" ? position.bottom_center : position.middle_center

var table flashTbl = table.new(f_flashYpos(), 1, 4, border_width = 2)

if flashOn and barstate.islast
    for r = 0 to 3
        table.cell(flashTbl, 0, r, "", bgcolor = color.new(color.gray, 100))
    if flashLeft > 0
        onPhase = (math.floor(timenow / 400) % 2) == 0
        bg  = onPhase ? flashBase : color.new(flashBase, 70)
        txt = onPhase ? color.white : flashBase
        table.cell(flashTbl, 0, 0, "  " + flashMsg + "  ", bgcolor = bg, text_color = txt, text_size = size.large)
        if showFlashPrices and flashHasPx
            table.cell(flashTbl, 0, 1, "E:  " + f_px(flashEntry), bgcolor = color.new(color.black, 15), text_color = color.white, text_size = size.normal)
            table.cell(flashTbl, 0, 2, "SL: " + f_px(flashSL),    bgcolor = color.new(color.black, 15), text_color = color.new(color.red,  0), text_size = size.normal)
            table.cell(flashTbl, 0, 3, "TP: " + f_px(flashTP),    bgcolor = color.new(color.black, 15), text_color = color.new(color.lime, 0), text_size = size.normal)

// =====================================================================
//  SMALL "RETEST" FLASH BOX (broken level revisited)
// =====================================================================
var int    retestLeft = 0
var string retestMsg  = ""

if barstate.isconfirmed
    if srRetestThisBar
        retestLeft := retestBars
        retestMsg  := srRetestIsRes ? "RETEST (old R -> S)" : "RETEST (old S -> R)"
    else if retestLeft > 0
        retestLeft := retestLeft - 1

var table retestTbl = table.new(position.bottom_center, 1, 1, border_width = 1)

if retestOn and barstate.islast
    table.cell(retestTbl, 0, 0, "", bgcolor = color.new(color.gray, 100))
    if retestLeft > 0
        onPhase2 = (math.floor(timenow / 400) % 2) == 0
        bg2  = onPhase2 ? colRetest : color.new(colRetest, 65)
        txt2 = onPhase2 ? color.black : colRetest
        table.cell(retestTbl, 0, 0, " " + retestMsg + " ", bgcolor = bg2, text_color = txt2, text_size = size.small)

// =====================================================================
//  CASCADE DASHBOARD
// =====================================================================
var table dash = table.new(position.top_right, 2, 7, border_width = 1)

f_biasTxt(b) =>
    b == 1 ? "^ BULL" : b == -1 ? "v BEAR" : "- flat"

f_biasCol(b) =>
    bullCol = color.new(color.green, 70)
    bearCol = color.new(color.red,   70)
    flatCol = color.new(color.gray,  70)
    b == 1 ? bullCol : b == -1 ? bearCol : flatCol

f_srActive() =>
    cnt = 0
    if array.size(srDrawn) > 0
        for i = 0 to array.size(srDrawn) - 1
            if array.get(srDrawn, i) and not array.get(srBroken, i)
                cnt += 1
    cnt

f_srArmed() =>
    cnt = 0
    if array.size(srArmed) > 0
        for i = 0 to array.size(srArmed) - 1
            if array.get(srArmed, i)
                cnt += 1
    cnt

if showDash and barstate.islast
    table.cell(dash, 0, 0, "TF",   bgcolor=color.new(color.black,70), text_color=color.white)
    table.cell(dash, 1, 0, "Bias", bgcolor=color.new(color.black,70), text_color=color.white)
    table.cell(dash, 0, 1, biasTF, text_color=color.white)
    table.cell(dash, 1, 1, f_biasTxt(biasD1),  bgcolor=f_biasCol(biasD1))
    table.cell(dash, 0, 2, midTF,  text_color=color.white)
    table.cell(dash, 1, 2, f_biasTxt(biasH4),  bgcolor=f_biasCol(biasH4))
    table.cell(dash, 0, 3, workTF, text_color=color.white)
    table.cell(dash, 1, 3, f_biasTxt(biasH1),  bgcolor=f_biasCol(biasH1))
    table.cell(dash, 0, 4, trigTF, text_color=color.white)
    table.cell(dash, 1, 4, f_biasTxt(biasM15), bgcolor=f_biasCol(biasM15))
    alignedTxt = alignBull ? "^ ALIGNED LONG" : alignBear ? "v ALIGNED SHORT" : "x NOT ALIGNED"
    alignedBg  = alignBull ? color.new(color.green,40) : alignBear ? color.new(color.red, 40) : color.new(color.gray, 40)
    table.cell(dash, 0, 5, "Cascade", text_color=color.white)
    table.cell(dash, 1, 5, alignedTxt, bgcolor=alignedBg, text_color=color.white)
    table.cell(dash, 0, 6, "S/R (armed)", text_color=color.white)
    table.cell(dash, 1, 6, str.tostring(f_srActive()) + " (" + str.tostring(f_srArmed()) + ")", text_color=color.white)

// =====================================================================
//  ENTRY ARROWS + ALERTS
// =====================================================================
plotshape(cascBuySig,   title="BUY Continuation",  style = shape.triangleup,   location = location.belowbar, color = colBuy,   size = size.small, text = "ICC^")
plotshape(cascSellSig,  title="SELL Continuation", style = shape.triangledown, location = location.abovebar, color = colSell,  size = size.small, text = "ICCv")
plotshape(retestBuySig, title="RETEST BUY",  style = shape.labelup,   location = location.belowbar, color = colRBuy,  textcolor = color.white, size = size.small, text = "RT^")
plotshape(retestSellSig,title="RETEST SELL", style = shape.labeldown, location = location.abovebar, color = colRSell, textcolor = color.white, size = size.small, text = "RTv")

alertcondition(cascBuySig,   "ICC BUY Continuation",  '{"symbol":"{{ticker}}","tf":"{{interval}}","side":"BUY","type":"continuation","price":{{close}},"strategy":"ICC-Sci-v3.1"}')
alertcondition(cascSellSig,  "ICC SELL Continuation", '{"symbol":"{{ticker}}","tf":"{{interval}}","side":"SELL","type":"continuation","price":{{close}},"strategy":"ICC-Sci-v3.1"}')
alertcondition(retestBuySig, "ICC RETEST BUY",  '{"symbol":"{{ticker}}","tf":"{{interval}}","side":"BUY","type":"retest","price":{{close}},"strategy":"ICC-Sci-v3.1"}')
alertcondition(retestSellSig,"ICC RETEST SELL", '{"symbol":"{{ticker}}","tf":"{{interval}}","side":"SELL","type":"retest","price":{{close}},"strategy":"ICC-Sci-v3.1"}')
alertcondition(exitLong,  "ICC EXIT Long",  "ICC exit LONG on {{ticker}} {{interval}}")
alertcondition(exitShort, "ICC EXIT Short", "ICC exit SHORT on {{ticker}} {{interval}}")
alertcondition(srBrokeThisBar,  "ICC S/R level broken",   "An S/R level was broken on {{ticker}} {{interval}}")
alertcondition(srRetestThisBar, "ICC S/R level retested", "A broken S/R level was retested on {{ticker}} {{interval}}")
