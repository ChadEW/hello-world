//@version=6
// =====================================================================
//  ICC_TradesBySci_Strategy_v3.3.8.pine  —  FULL SMC STRATEGY PORT
//  ------------------------------------------------------------------
//  Backtestable twin: one identical SMC engine routed through
//  strategy.entry/exit for real fill counts / equity / drawdown on the
//  genuine Sci logic (bias -> sweep+reclaim -> displacement MSS ->
//  discount/premium pullback into FVG (+optional OB) -> continuation).
//
//  v3.3.9 EXIT LABELS (visible closes) — 2026-08-05
//    ADDITIVE VISUAL. Prior builds executed closes (opposite-signal
//    strategy.close + strategy.exit SL/TP/trailing) but drew ONLY entry
//    markers, so exits were visible only in TradingView's native "List
//    of Trades". This build draws an on-chart label at each CLOSED trade.
//    Mechanism (no trading logic touched): each confirmed bar compares
//    strategy.closedtrades to its prior value; for every newly-closed
//    trade it reads strategy.closedtrades.exit_bar_index / .exit_price /
//    .exit_id / .profit and drops a label at the exit bar+price. Label
//    text = exit id (XL/XS = SL/TP/trail exit; EXIT LONG/SHORT = opposite-
//    signal close) + optional net profit; green = win, red = loss. New
//    input group "Exit Labels": showExitLabels, exitLblShowProfit,
//    exitLblWinCol, exitLblLossCol, plus a dashboard "Exit lbls" readout.
//    Nothing else (bias, sweep, displacement, FVG/OB, S/R, sizing, TP,
//    ATR-auto, FVG-relax) changed. Mirrors EA v3.3.10 for platform parity.
//
//  v3.3.8 FVG CONTAINMENT RELAXATION (fixes "IND+COR print, no
//  CONTINUATION") — 2026-08-04
//    Root cause of the missing continuation: with InpRequireFVGpullback
//    ON (default), the phase-2 -> continuation gate demanded that the
//    single, ever-deepening WorkTF correction extreme (corrExtreme) sit
//    EXACTLY inside a still-ACTIVE same-side FVG. That point-in-gap test
//    failed routinely because (a) corrExtreme is a WorkTF (H1) price but
//    FVGs are detected on the chart TF (timeframe mismatch), (b) the gap
//    is often already retired (fill% >= InpFVGFillInvalidate) by arrival,
//    and (c) math.min/max keeps pushing corrExtreme past the gap edge.
//    So IND and COR labels print, then the setup silently resets.
//    FIX (opt-in, additive): new toggle relaxFVGcontain. When ON, the
//    continuation accepts a correction extreme that is NEAR an active
//    same-side FVG (containment tolerance, fixed pips or x ATR) AND/OR
//    whose discount/premium BAND overlaps an active gap (useFVGband).
//    When OFF (default) the EXACT v3.3.7 point-in-gap behaviour is
//    preserved. Helper fvgContainOK() unifies both paths; nothing else
//    (bias, sweep, displacement, OB gate, S/R, sizing, TP, ATR-auto) is
//    touched. Mirrors EA v3.3.9 for platform parity.
//
//  v3.3.7 ZERO-TRADE / BAR-0 ARRAY-GUARD FIX — 2026-07-30
//    Fixes the TradingView runtime crash: "Error on bar 0: In 'array.get()'
//    function. Index 0 is out of bounds, array size is 0." Root cause:
//    Pine's `for i = 0 to array.size(x) - 1` counts DOWNWARD to -1 when the
//    array is EMPTY (size 0), so array.get(x, 0) executes against an empty
//    array on bar 0 and kills the script before any trade can print.
//    Every FVG/OB iteration is now wrapped in `if array.size(x) > 0` so an
//    empty collection is skipped cleanly. Guarded: nearestFVG, inActiveFVG,
//    nearestOB, inUnmitigatedOB, inActiveOB, the FVG fill/draw loop, and the
//    OB mitigate/draw loop (the actual bar-0 trigger). NO trading logic,
//    thresholds, entry paths, S/R, sizing, or ATR-auto behaviour changed —
//    the engine now runs from the first bar and reports trades normally.
//
//  v3.3.6 ATR-AUTO PIP INPUTS (self-tuning; opt-in) — 2026-07-28
//    New toggle useATRauto. When ON, the pip-scaled STRUCTURE + BUFFER +
//    RISK thresholds are derived live from a fraction of ATR instead of
//    the fixed *Pips inputs, so they self-size to whatever symbol/TF is
//    loaded. When OFF (default) the exact v3.3.5 fixed-pip behaviour is
//    preserved. Helper f_pd(fixedPips, atrFrac) returns a PRICE DISTANCE:
//        useATRauto ? atrFrac*ATR(atrAutoLen) : fixedPips*pip
//    Routed: srTol, brkBuf, confBuf, retest/ICC SL buffers, equal-level
//    tol, sweep min, FVG min, structural SL buffer, trail start/step,
//    break-even trigger/lock. Fractions seeded from the manual Step-2 table.
//
//  LINEAGE (all preserved):
//   v3.3.5 CROSS-ASSET SCALING; v3.3.4 SMC engine + ZERO-TRADE FIX
//   (inActiveOB, InpRequireOB OFF, metal pip); v3.3.3 transparency;
//   v3.3.1 RE10008 guards; v3.2 soft-D1; v2.2 structural take-profit.
//   v3.3.7 empty-array/bar-0 guards (all preserved unchanged).
//
//  Built for Chad Woodyard, July 2026.  v6 wrap-hardened,
//  CW10003-safe (history refs hoisted), CE10235-safe (unified returns).
// =====================================================================
strategy("ICC TradesBySci Strategy v3.3.9", "ICC-Sci Strat v3.3.9", overlay = true,
     initial_capital       = 10000,
     default_qty_type      = strategy.percent_of_equity,
     default_qty_value     = 100,
     pyramiding            = 0,
     calc_on_every_tick    = false,
     process_orders_on_close = true,
     max_lines_count       = 500,
     max_labels_count      = 500,
     max_boxes_count       = 500)
// ============================ INPUTS: Entry Paths ===================
grpEP     = "Entry Paths"
useICC       = input.bool(true,  "ICC pullback entries (Indication->Correction->Continuation)", group = grpEP)
useRetest    = input.bool(true,  "Retest-confirmation entries",  group = grpEP)
useCascade   = input.bool(false, "Cascade BREAKOUT entries (v1 path)", group = grpEP)
closeOnOpp   = input.bool(true,  "Close open trade on opposite signal", group = grpEP)
// ============================ INPUTS: Bias / Filter =================
grpBias   = "Bias / Filter (Sci: HTF sets bias, LTF entry)"
biasLoose      = input.bool(true,  "Loosen bias: single BOS sets trend (HH w/o LL = bull)", group = grpBias)
useD1Filter    = input.bool(true,  "Let D1 influence HTF bias as a SOFT weight", group = grpBias)
d1Weight       = input.float(0.5,  "D1 weight vs H4 (0=ignore, 1.0=~old hard veto, >1 D1 dominates)", minval = 0.0, maxval = 3.0, step = 0.1, group = grpBias)
htfMinConv     = input.float(0.5,  "Min net HTF score (same side as H4) required to trade", minval = 0.0, maxval = 3.0, step = 0.1, group = grpBias)
strictAlign    = input.bool(false, "v1 lockstep: require ALL four TFs to agree", group = grpBias)
// ============================ INPUTS: ICC Pullback ==================
grpICC    = "ICC Pullback Tuning"
corrRetMin   = input.float(0.500, "Min pullback into discount/premium (fib of impulse)", minval = 0.1, maxval = 0.95, step = 0.01, group = grpICC)
corrRetMax   = input.float(0.900, "Max pullback before setup invalidates (fib)", minval = 0.2, maxval = 1.0, step = 0.01, group = grpICC)
iccExpiry    = input.int(30, "Bars to complete Correction+Continuation", minval = 3, group = grpICC)
iccSLbufPips = input.float(3.0, "ICC SL buffer beyond correction extreme (pips)", minval = 0.0, step = 0.5, group = grpICC)
// ============================ INPUTS: Cascade =======================
grpTF     = "Timeframe Cascade (D1 -> H4 -> H1 -> M15)"
biasTF    = input.timeframe("D",   "Top bias TF (Indication filter)", group = grpTF)
midTF     = input.timeframe("240", "Mid / primary Indication TF",     group = grpTF)
workTF    = input.timeframe("60",  "Working TF (swing anchor)",       group = grpTF)
trigTF    = input.timeframe("15",  "Trigger TF (Entry timing)",       group = grpTF)
cascadeSwingLen = input.int(5, "Cascade pivot length (bars L/R)", minval = 2, group = grpTF)
showDash  = input.bool(true, "Show cascade dashboard", group = grpTF)
// ============================ INPUTS: Risk / Stops ==================
grpRisk   = "Stops / Sizing"
slMethod  = input.string("Smart", "SL method", options = ["Structural","ATR","Smart"], group = grpRisk)
atrLen    = input.int(14,   "ATR period", minval = 1, group = grpRisk)
atrMult   = input.float(1.5,"ATR multiplier", minval = 0.1, step = 0.1, group = grpRisk)
slBufPips = input.float(50, "Extra structural buffer (pips)", minval = 0, step = 1, group = grpRisk)
rrRatio   = input.float(2.0,"TP reward : risk", minval = 0.1, step = 0.1, group = grpRisk)
useTrail  = input.bool(true, "Use trailing stop", group = grpRisk)
trailStartPips = input.float(200, "Trailing start (pips)", minval = 0, step = 1, group = grpRisk)
trailStepPips  = input.float(100, "Trailing distance (pips)", minval = 1, step = 1, group = grpRisk)
useBE     = input.bool(true, "Use break-even", group = grpRisk)
beAtPips  = input.float(150, "Break-even trigger (pips)", minval = 0, step = 1, group = grpRisk)
beLockPips= input.float(10,  "Break-even lock profit (pips)", minval = 0, step = 1, group = grpRisk)
// ============================ INPUTS: Take-Profit Mode (v2.2) =======
grpTP     = "Take-Profit Mode (v2.2)"
tpMode    = input.string("Fixed RR", "TP target", options = ["Fixed RR","Structural"], group = grpTP, tooltip = "Fixed RR = entry +/- stop*RR. Structural = nearest un-broken S/R beyond entry (Sci: previous high / next liquidity pool).")
tpLookback= input.int(200, "Structural: working-TF bars scanned for fallback swing target", minval = 10, group = grpTP)
tpMinRR   = input.float(1.0, "Structural: reject/floor targets below this reward:risk", minval = 0.1, step = 0.1, group = grpTP)
// ============================ INPUTS: Session =======================
grpSess   = "Session Filter"
useSession   = input.bool(false, "Restrict entries to a session", group = grpSess)
sessionSpec  = input.session("1330-2000", "Session (exchange time)", group = grpSess)
// ============================ INPUTS: S/R ===========================
grpSR     = "Support / Resistance (body-close levels)"
srShow    = input.bool(true,  "Run body-close S/R engine",               group = grpSR)
srMinTouch= input.int(3,      "Min body closes to confirm a level",       minval = 2, group = grpSR)
srTolPips = input.float(10.0, "Zone tolerance (pips)",                    minval = 0.1, step = 0.5, group = grpSR)
srDurMode = input.string("Calendar Days", "Level duration unit", options = ["Calendar Days","Trading Sessions"], group = grpSR)
srDurN    = input.int(3,      "Level duration (days or sessions)",        minval = 1, group = grpSR)
srColRes  = input.color(color.new(color.orange, 0), "Resistance color",  group = grpSR)
srColSup  = input.color(color.new(color.teal,   0), "Support color",     group = grpSR)
srFillTransp = input.int(76, "S/R fill transparency (0=opaque .. 100=fully transparent)", minval = 0, maxval = 100, group = grpSR)
srUseZone = input.bool(true,  "Draw as shaded zone (box) vs line",       group = grpSR)
srShowCnt = input.bool(true,  "Show touch-count label",                  group = grpSR)
srRefLen  = input.int(20,     "Reference SMA length (S/R classifier)",    minval = 5, group = grpSR)
autoScaleByAsset = input.bool(true, "Auto-scale pip by asset class (fx/metal/index/crypto) - mirrors EA DetectAssetClass", group = grpSR)
// ============================ INPUTS: ATR-Auto Pip (self-tuning) ====
// v3.3.6: when ON, pip-scaled structure/buffer/risk thresholds are derived
// from ATR fractions (self-size per symbol/TF). OFF = fixed *Pips (v3.3.5).
grpATR    = "ATR-Auto Pip (self-tuning)"
useATRauto     = input.bool(false, "Derive pip-scaled thresholds from ATR (ignore fixed *Pips)", group = grpATR, tooltip = "OFF = v3.3.5 fixed-pip behaviour. ON = each threshold = fraction x ATR(atrAutoLen).")
atrAutoLen     = input.int(14,   "ATR length for auto pip", minval = 1, group = grpATR)
fracSRtol      = input.float(0.35, "S/R zone tol (x ATR)",        minval = 0.01, step = 0.01, group = grpATR)
fracFVG        = input.float(0.20, "Min FVG size (x ATR)",        minval = 0.01, step = 0.01, group = grpATR)
fracSweep      = input.float(0.15, "Min sweep penetration (x ATR)",minval = 0.01, step = 0.01, group = grpATR)
fracEqual      = input.float(0.15, "Equal H/L tol (x ATR)",       minval = 0.01, step = 0.01, group = grpATR)
fracICCsl      = input.float(0.30, "ICC SL buffer (x ATR)",       minval = 0.0,  step = 0.01, group = grpATR)
fracRetestSL   = input.float(0.30, "Retest SL buffer (x ATR)",    minval = 0.0,  step = 0.01, group = grpATR)
fracConf       = input.float(0.10, "Retest confirm buffer (x ATR)",minval = 0.0, step = 0.01, group = grpATR)
fracBrk        = input.float(0.10, "Break buffer (x ATR)",        minval = 0.0,  step = 0.01, group = grpATR)
fracSLbuf      = input.float(0.30, "Structural SL buffer (x ATR)",minval = 0.0,  step = 0.01, group = grpATR)
fracTrailStart = input.float(1.00, "Trailing start (x ATR)",      minval = 0.0,  step = 0.05, group = grpATR)
fracTrailStep  = input.float(0.50, "Trailing distance (x ATR)",   minval = 0.01, step = 0.05, group = grpATR)
fracBEat       = input.float(0.80, "Break-even trigger (x ATR)",  minval = 0.0,  step = 0.05, group = grpATR)
fracBElock     = input.float(0.10, "Break-even lock (x ATR)",     minval = 0.0,  step = 0.01, group = grpATR)
// ============================ INPUTS: Broken level ==================
grpBrk    = "Broken-Level Behavior"
brkMode   = input.string("Gray Out", "When a level is broken", options = ["Gray Out","Delete"], group = grpBrk, tooltip = "Retest entries require Gray Out.")
brkBufPips= input.float(2.0, "Break buffer beyond level (pips)", minval = 0.0, step = 0.5, group = grpBrk)
brkColor  = input.color(color.new(color.gray, 40), "Grayed-out color", group = grpBrk)
// ============================ INPUTS: Retest ========================
grpRe     = "Retest-Confirmation Entry"
retestConfBufPips = input.float(1.0, "Rejection confirmation buffer (pips)", minval = 0.0, step = 0.5, group = grpRe)
retestArmBars     = input.int(5, "Arm window (bars) after a retest", minval = 1, maxval = 50, group = grpRe)
retestSepBar      = input.bool(true, "Require a separate confirmation bar", group = grpRe)
retestSLbufPips   = input.float(3.0, "Retest SL buffer beyond level (pips)", minval = 0.0, step = 0.5, group = grpRe)
// ============================ INPUTS: Swings ========================
grpSw     = "Swing / Structure (Sci style)"
showSwings= input.bool(true, "Draw swing high/low rays",       group = grpSw)
swingLen  = input.int(5,     "Swing pivot length (bars L/R)",  minval = 2, group = grpSw)
maxSwings = input.int(6,     "Max recent swing lines kept",    minval = 1, maxval = 30, group = grpSw)
colHigh   = input.color(color.new(#1E88E5, 0), "Swing High (sellers' line)", group = grpSw)
colLow    = input.color(color.new(#E53935, 0), "Swing Low (buyers' line)",   group = grpSw)
// ============================ INPUTS: Diagnostics ===================
grpDiag   = "Diagnostics"
showICClabels = input.bool(true, "Show ICC phase labels on chart", group = grpDiag)
// ============================ INPUTS: Exit Labels (v3.3.9) ==========
// Draw an on-chart label at every CLOSED trade (SL / TP / trail / opposite-
// signal close). Purely visual; reads closed-trade metadata, changes no logic.
grpExit           = "Exit Labels (v3.3.9)"
showExitLabels    = input.bool(true,  "Draw a label at each closed trade", group = grpExit, tooltip = "Reads strategy.closedtrades metadata each bar and labels newly-closed trades. XL/XS = SL/TP/trailing exit; EXIT LONG/SHORT = opposite-signal close.")
exitLblShowProfit = input.bool(true,  "Include net profit on the exit label", group = grpExit)
exitLblWinCol     = input.color(color.new(color.teal,   15), "Winning-exit label colour", group = grpExit)
exitLblLossCol    = input.color(color.new(color.maroon, 15), "Losing-exit label colour",  group = grpExit)
// ============================ INPUTS: SMC ENGINE (v3.3.4) ===========
grpStr = "SMC: Protected Swings / Structure"
InpIntSwingStrength    = input.int(2,   "Internal swing strength (bars each side)", group=grpStr, minval=1)
InpExtSwingStrength    = input.int(4,   "External swing strength (bars each side)", group=grpStr, minval=1)
InpStructLookback      = input.int(300, "Bars scanned for protected swings", group=grpStr, minval=20)
InpBOSUseClose         = input.bool(true,"BOS requires BODY close beyond swing", group=grpStr)
InpExtTrendControlsDir = input.bool(true,"External trend gates trade DIRECTION", group=grpStr)
InpIntTrendControlsEnt = input.bool(true,"Internal BOS gates the ENTRY (Indication)", group=grpStr)
grpLiq = "SMC: Liquidity Engine"
InpRequireSweep     = input.bool(true, "Require liquidity sweep + reclaim before Indication", group=grpLiq)
InpLiqLookback      = input.int(120,  "Bars scanned for pools / equal levels", group=grpLiq, minval=10)
InpEqualLevelTolPips= input.float(2.0,"Equal highs/lows tolerance (pips)", group=grpLiq)
InpRequireReclaim   = input.bool(true,"Require price to RECLAIM the swept level", group=grpLiq)
InpReclaimBars      = input.int(3,    "Bars allowed for the reclaim", group=grpLiq, minval=1)
InpSweepValidBars   = input.int(8,    "Sweep stays valid to arm for N bars", group=grpLiq, minval=1)
InpSweepMinPips     = input.float(1.0,"Min penetration beyond the level (pips)", group=grpLiq)
grpFVG = "SMC: Fair Value Gaps"
InpRequireFVGpullback= input.bool(true, "Correction must pull back into an active FVG", group=grpFVG)
InpDrawFVG          = input.bool(true, "Draw detected FVGs", group=grpFVG)
InpFVGScanBars      = input.int(120,   "Bars scanned each update for FVGs", group=grpFVG, minval=10)
InpMaxTrackedFVG    = input.int(40,    "Max FVGs tracked", group=grpFVG, minval=1)
InpMinFVGPips       = input.float(1.0, "Min Fair Value Gap size (pips)", group=grpFVG)
InpFVGFillInvalidate= input.float(100.0,"Fill % that retires an FVG", group=grpFVG)
InpFVGBullColor     = input.color(color.new(color.teal,80),  "Bullish FVG colour", group=grpFVG)
InpFVGBearColor     = input.color(color.new(color.maroon,80),"Bearish FVG colour", group=grpFVG)
grpDisp = "SMC: Institutional Displacement"
InpRejectWeakBreaks = input.bool(true, "Reject Indication breaks below score", group=grpDisp)
InpDispATRPeriod    = input.int(14,   "ATR period for displacement", group=grpDisp, minval=1)
InpDispATRMult      = input.float(1.5,"Range >= ATR*mult = full ATR points", group=grpDisp)
InpDispMinBodyPct   = input.float(0.50,"Min body/range", group=grpDisp)
InpDispMinCloseStr  = input.float(0.60,"Min closing strength", group=grpDisp)
InpDispMaxWickRatio = input.float(1.00,"Max opposing-wick/body ratio", group=grpDisp)
InpDispMinScore     = input.float(60.0,"Reject displacement below score (0..100)", group=grpDisp)
grpOB = "SMC: Order / Mitigation Blocks"
InpUseOrderBlocks   = input.bool(true, "Enable order-block detection & tracking", group=grpOB)
InpRequireOB        = input.bool(false, "Continuation must occur inside an ACTIVE (unviolated) OB", group=grpOB)
InpOBScanBack       = input.int(8,     "Bars searched back from displacement for OB", group=grpOB, minval=1)
InpMaxTrackedOB     = input.int(40,    "Max order blocks tracked", group=grpOB, minval=1)
InpOBMitigateOnClose= input.bool(true, "OB invalidated on BODY close through", group=grpOB)
InpDrawOB           = input.bool(true, "Draw order blocks", group=grpOB)
InpOBBullColor      = input.color(color.new(color.green,70),"Bullish OB colour", group=grpOB)
InpOBBearColor      = input.color(color.new(color.red,70),  "Bearish OB colour", group=grpOB)
// ============================ INPUTS: FVG Containment Relaxation (v3.3.8) ===
// Fixes "IND + COR print but no CONTINUATION". OFF (default) = exact v3.3.7
// point-in-gap containment. ON = accept a correction extreme that is NEAR an
// active same-side FVG (tolerance) and/or whose discount/premium BAND overlaps
// an active gap, absorbing the WorkTF-vs-chartTF timeframe mismatch + drift.
grpFVGRelax = "SMC: FVG Containment Relaxation (v3.3.8)"
relaxFVGcontain   = input.bool(false, "Relax the continuation active-FVG containment test", group = grpFVGRelax, tooltip = "OFF = exact v3.3.7 point-in-gap test. ON = a correction extreme NEAR an active same-side FVG (tolerance) and/or whose discount/premium BAND overlaps the gap qualifies. Keeps FVG confluence while fixing TF-mismatch/drift misses.")
fvgContainTolPips = input.float(5.0,  "Containment tolerance (pips) - inside if within this of a gap edge", minval = 0.0, step = 0.5, group = grpFVGRelax)
fvgContainFrac    = input.float(0.25, "Containment tolerance (x ATR) when ATR-auto ON", minval = 0.0, step = 0.01, group = grpFVGRelax)
useFVGband        = input.bool(true,  "Also accept when the discount/premium BAND overlaps an active gap", group = grpFVGRelax)
// ============================ ASSET CLASS + PIP / TOL ===============
f_assetClass() =>
    t = str.upper(syminfo.ticker)
    isMet = str.contains(t,"XAU") or str.contains(t,"GOLD") or str.contains(t,"XAG") or str.contains(t,"SILVER") or str.contains(t,"XPT") or str.contains(t,"XPD")
    isCry = str.contains(t,"BTC") or str.contains(t,"ETH") or str.contains(t,"XRP") or str.contains(t,"LTC") or str.contains(t,"BCH") or str.contains(t,"SOL") or str.contains(t,"DOGE") or str.contains(t,"ADA")
    isIdx = str.contains(t,"US30") or str.contains(t,"US500") or str.contains(t,"NAS") or str.contains(t,"SPX") or str.contains(t,"DJ") or str.contains(t,"DAX") or str.contains(t,"FTSE") or str.contains(t,"NIK") or str.contains(t,"HK50") or str.contains(t,"AUS200") or str.contains(t,"GER") or str.contains(t,"UK100")
    isFx  = str.contains(syminfo.type, "forex")
    isMet ? "METAL" : isCry ? "CRYPTO" : isIdx ? "INDEX" : isFx ? "FOREX" : "OTHER"
assetClass = f_assetClass()
basePip = syminfo.mintick * ((assetClass == "FOREX" or assetClass == "METAL") ? 10 : 1)
assetMult = not autoScaleByAsset ? 1.0 : assetClass == "INDEX" ? 20.0 : assetClass == "CRYPTO" ? 300.0 : 1.0
pip     = basePip * assetMult
// v3.3.6: ATR-auto pip. f_pd returns a PRICE DISTANCE: fraction*ATR when
// useATRauto (and ATR ready), else fixed pips*pip. Warmup falls back to fixed.
atrAuto = ta.atr(atrAutoLen)
f_pd(float fixedPips, float atrFrac) =>
    (useATRauto and not na(atrAuto) and atrAuto > 0) ? atrFrac * atrAuto : fixedPips * pip
srTol        = f_pd(srTolPips,            fracSRtol)
brkBuf       = f_pd(brkBufPips,           fracBrk)
confBuf      = f_pd(retestConfBufPips,    fracConf)
slBuf        = f_pd(retestSLbufPips,      fracRetestSL)
iccSLbuf     = f_pd(iccSLbufPips,         fracICCsl)
equalTolDist = f_pd(InpEqualLevelTolPips, fracEqual)
sweepMinDist = f_pd(InpSweepMinPips,      fracSweep)
fvgMinDist   = f_pd(InpMinFVGPips,        fracFVG)
fvgContainTol= f_pd(fvgContainTolPips,    fvgContainFrac)   // v3.3.8 FVG containment tolerance (ATR-auto or fixed)
slBufP       = f_pd(slBufPips,            fracSLbuf)
trailStart   = f_pd(trailStartPips,       fracTrailStart)
trailStepD   = f_pd(trailStepPips,        fracTrailStep)
beAt         = f_pd(beAtPips,             fracBEat)
beLock       = f_pd(beLockPips,           fracBElock)
inSession = not useSession or not na(time(timeframe.period, sessionSpec))
// ============================ SESSION COUNTER =======================
var int sessCount = 0
dayChange = ta.change(time("D"))
if not na(dayChange) and dayChange != 0
    sessCount += 1
srRef = ta.sma(close, srRefLen)
atrVal = ta.atr(atrLen)
// ============================ CASCADE BIAS ENGINE (loosened) ========
f_bias(_tf) =>
    [ph1, pl1] = request.security(syminfo.tickerid, _tf, [ta.pivothigh(cascadeSwingLen, cascadeSwingLen), ta.pivotlow(cascadeSwingLen, cascadeSwingLen)], lookahead = barmerge.lookahead_off)
    var float lastH1 = na
    var float prevH1 = na
    var float lastL1 = na
    var float prevL1 = na
    if not na(ph1)
        prevH1 := lastH1
        lastH1 := ph1
    if not na(pl1)
        prevL1 := lastL1
        lastL1 := pl1
    haveAll = not na(lastH1) and not na(prevH1) and not na(lastL1) and not na(prevL1)
    hh = haveAll and lastH1 > prevH1
    hl = haveAll and lastL1 > prevL1
    lh = haveAll and lastH1 < prevH1
    ll = haveAll and lastL1 < prevL1
    b = 0
    if biasLoose
        b := (hh and not ll) ? 1 : (ll and not hh) ? -1 : 0
    else
        b := (hh and hl) ? 1 : (lh and ll) ? -1 : 0
    b
biasD1 = f_bias(biasTF)
biasH4 = f_bias(midTF)
biasH1 = f_bias(workTF)
biasM15= f_bias(trigTF)
strictBull = biasD1 ==  1 and biasH4 ==  1 and biasH1 ==  1 and biasM15 ==  1
strictBear = biasD1 == -1 and biasH4 == -1 and biasH1 == -1 and biasM15 == -1
looseBull  = biasH1 ==  1 and biasM15 ==  1
looseBear  = biasH1 == -1 and biasM15 == -1
alignBull  = strictAlign ? strictBull : looseBull
alignBear  = strictAlign ? strictBear : looseBear
f_htfScore() =>
    useD1Filter ? (biasH4 + biasD1 * d1Weight) : biasH4
f_htf() =>
    r = 0
    sc = f_htfScore()
    if biasH4 == 0
        r := 0
    else if not useD1Filter
        r := biasH4
    else if biasH4 == 1 and sc >= htfMinConv
        r := 1
    else if biasH4 == -1 and sc <= -htfMinConv
        r := -1
    else
        r := 0
    r
htfScore = f_htfScore()
htf = f_htf()
// ============================ WORKING-TF SWINGS =====================
var float wkLastHi = na
var float wkLastLo = na
wkHi = request.security(syminfo.tickerid, workTF, ta.pivothigh(cascadeSwingLen, cascadeSwingLen), lookahead = barmerge.lookahead_off)
wkLo = request.security(syminfo.tickerid, workTF, ta.pivotlow (cascadeSwingLen, cascadeSwingLen), lookahead = barmerge.lookahead_off)
if not na(wkHi)
    wkLastHi := wkHi
if not na(wkLo)
    wkLastLo := wkLo
wkH1c = request.security(syminfo.tickerid, workTF, high[1], lookahead = barmerge.lookahead_off)
wkL1c = request.security(syminfo.tickerid, workTF, low[1],  lookahead = barmerge.lookahead_off)
m15c1 = request.security(syminfo.tickerid, trigTF, close[1], lookahead = barmerge.lookahead_off)
m15h2 = request.security(syminfo.tickerid, trigTF, high[2],  lookahead = barmerge.lookahead_off)
m15l2 = request.security(syminfo.tickerid, trigTF, low[2],   lookahead = barmerge.lookahead_off)
// =====================================================================
//  v3.3.4 SMART MONEY STRUCTURE ENGINE (MSE) — ported 1:1 from indicator
// =====================================================================
atrMSE = ta.atr(InpDispATRPeriod)
isFractalHigh(int shift, int strength) =>
    if shift <= strength or bar_index < shift + strength
        false
    else
        bool ok = true
        float h = high[shift]
        for k = 1 to strength
            if high[shift + k] >= h or high[shift - k] >= h
                ok := false
                break
        ok
isFractalLow(int shift, int strength) =>
    if shift <= strength or bar_index < shift + strength
        false
    else
        bool ok = true
        float l = low[shift]
        for k = 1 to strength
            if low[shift + k] <= l or low[shift - k] <= l
                ok := false
                break
        ok
findProtected(int strength) =>
    float pH = na
    float pL = na
    if bar_index < strength * 2 + 2
        [na, na]
    else
        int maxBars = math.min(InpStructLookback, bar_index - strength)
        for s = strength + 1 to maxBars
            if na(pH) and isFractalHigh(s, strength)
                pH := high[s]
            if na(pL) and isFractalLow(s, strength)
                pL := low[s]
            if not na(pH) and not na(pL)
                break
        [pH, pL]
scoreDisplacement(int shift, int dir) =>
    o = open[shift]
    c = close[shift]
    h = high[shift]
    l = low[shift]
    rng = h - l
    float score = 0.0
    if rng > 0
        dirOk = dir == 1 ? c > o : c < o
        if dirOk
            body     = math.abs(c - o)
            bodyPct  = body / rng
            closeStr = dir == 1 ? (c - l) / rng : (h - c) / rng
            oppWick  = dir == 1 ? (h - c) : (c - l)
            wickRat  = body > 0 ? oppWick / body : 999.0
            af       = atrMSE > 0 ? rng / atrMSE : 0.0
            sBody  = math.min(bodyPct  / math.max(InpDispMinBodyPct , 0.01), 1.0) * 30.0
            sClose = math.min(closeStr / math.max(InpDispMinCloseStr, 0.01), 1.0) * 25.0
            sWick  = math.min(InpDispMaxWickRatio / math.max(wickRat, 0.0001), 1.0) * 15.0
            sATR   = math.min(af       / math.max(InpDispATRMult   , 0.01), 1.0) * 30.0
            score := math.min(sBody + sClose + sWick + sATR, 100.0)
    score
detectEqualHighs() =>
    float lvl = na
    float first = na
    str = InpExtSwingStrength
    tol = equalTolDist
    for s = str + 1 to InpLiqLookback
        if isFractalHigh(s, str)
            h = high[s]
            if na(first)
                first := h
            else if math.abs(h - first) <= tol
                lvl := (h + first) / 2.0
                break
            else
                first := h
    lvl
detectEqualLows() =>
    float lvl = na
    float first = na
    str = InpExtSwingStrength
    tol = equalTolDist
    for s = str + 1 to InpLiqLookback
        if isFractalLow(s, str)
            l = low[s]
            if na(first)
                first := l
            else if math.abs(l - first) <= tol
                lvl := (l + first) / 2.0
                break
            else
                first := l
    lvl
var float[] fvgTopA  = array.new_float()
var float[] fvgBotA  = array.new_float()
var int[]   fvgDirA  = array.new_int()
var float[] fvgFillA = array.new_float()
var bool[]  fvgActA  = array.new_bool()
var box[]   fvgBoxA  = array.new_box()
addFVG(float top, float bot, int dir, int bidx) =>
    if array.size(fvgTopA) >= InpMaxTrackedFVG
        if array.size(fvgBoxA) > 0
            box.delete(array.shift(fvgBoxA))
        array.shift(fvgTopA), array.shift(fvgBotA), array.shift(fvgDirA)
        array.shift(fvgFillA), array.shift(fvgActA)
    array.push(fvgTopA, top)
    array.push(fvgBotA, bot)
    array.push(fvgDirA, dir)
    array.push(fvgFillA, 0.0)
    array.push(fvgActA, true)
    bx = InpDrawFVG ? box.new(bidx, top, bar_index, bot, border_color=na, bgcolor=(dir==1?InpFVGBullColor:InpFVGBearColor)) : na
    array.push(fvgBoxA, bx)
nearestFVG(int tradeDir) =>
    int best = -1
    float bestD = 1e20
    px = close[1]
    if array.size(fvgTopA) > 0                                     // v3.3.7 guard: skip empty array (bar-0 array.get fix)
        for i = 0 to array.size(fvgTopA) - 1
            if array.get(fvgActA, i) and array.get(fvgDirA, i) == tradeDir
                mid = (array.get(fvgTopA, i) + array.get(fvgBotA, i)) / 2.0
                d = math.abs(px - mid)
                if d < bestD
                    bestD := d
                    best  := i
    best
inActiveFVG(int tradeDir, float price) =>
    bool found = false
    if array.size(fvgTopA) > 0                                     // v3.3.7 guard
        for i = 0 to array.size(fvgTopA) - 1
            if array.get(fvgActA, i) and array.get(fvgDirA, i) == tradeDir
                if price <= array.get(fvgTopA, i) and price >= array.get(fvgBotA, i)
                    found := true
                    break
    found
// v3.3.8: price counts as "inside" if within `tol` of an active same-side FVG
// edge (absorbs WorkTF-vs-chartTF mismatch + corrExtreme drift past the edge).
inActiveFVGtol(int tradeDir, float price, float tol) =>
    bool found = false
    if array.size(fvgTopA) > 0                                     // empty-array guard (v3.3.7 parity)
        for i = 0 to array.size(fvgTopA) - 1
            if array.get(fvgActA, i) and array.get(fvgDirA, i) == tradeDir
                if price <= array.get(fvgTopA, i) + tol and price >= array.get(fvgBotA, i) - tol
                    found := true
                    break
    found
// v3.3.8: does the price band [lo..hi] overlap ANY active same-side FVG?
// (interval-overlap test: lo <= gapTop and hi >= gapBot).
bandOverlapsFVG(int tradeDir, float lo, float hi) =>
    bool found = false
    if array.size(fvgTopA) > 0                                     // empty-array guard (v3.3.7 parity)
        for i = 0 to array.size(fvgTopA) - 1
            if array.get(fvgActA, i) and array.get(fvgDirA, i) == tradeDir
                gTop = array.get(fvgTopA, i)
                gBot = array.get(fvgBotA, i)
                if lo <= gTop and hi >= gBot
                    found := true
                    break
    found
// v3.3.8: unified continuation FVG-containment gate. relax OFF => EXACT v3.3.7
// point-in-gap. relax ON => point-in-gap OR near-edge tolerance OR (optional)
// discount/premium band overlap. `bandFrom` is the shallow edge of the pullback
// band (disc for longs, prem for shorts); `price` is the correction extreme.
fvgContainOK(int tradeDir, float price, float bandFrom) =>
    ok = inActiveFVG(tradeDir, price)
    if relaxFVGcontain and not ok
        ok := inActiveFVGtol(tradeDir, price, fvgContainTol)
        if not ok and useFVGband
            lo = math.min(price, bandFrom)
            hi = math.max(price, bandFrom)
            ok := bandOverlapsFVG(tradeDir, lo, hi)
    ok
var float[] obTopA = array.new_float()
var float[] obBotA = array.new_float()
var int[]   obDirA = array.new_int()
var bool[]  obMitA = array.new_bool()
var bool[]  obActA = array.new_bool()
var box[]   obBoxA = array.new_box()
addOB(float top, float bot, int dir, int bidx) =>
    if array.size(obTopA) >= InpMaxTrackedOB
        if array.size(obBoxA) > 0
            box.delete(array.shift(obBoxA))
        array.shift(obTopA), array.shift(obBotA), array.shift(obDirA)
        array.shift(obMitA), array.shift(obActA)
    array.push(obTopA, top)
    array.push(obBotA, bot)
    array.push(obDirA, dir)
    array.push(obMitA, false)
    array.push(obActA, true)
    bx = InpDrawOB ? box.new(bidx, top, bar_index, bot, border_color=(dir==1?InpOBBullColor:InpOBBearColor), bgcolor=na, border_width=2) : na
    array.push(obBoxA, bx)
nearestOB(int tradeDir) =>
    int best = -1
    float bestD = 1e20
    px = close[1]
    if array.size(obTopA) > 0                                      // v3.3.7 guard
        for i = 0 to array.size(obTopA) - 1
            if array.get(obActA, i) and not array.get(obMitA, i) and array.get(obDirA, i) == tradeDir
                mid = (array.get(obTopA, i) + array.get(obBotA, i)) / 2.0
                d = math.abs(px - mid)
                if d < bestD
                    bestD := d
                    best  := i
    best
inUnmitigatedOB(int tradeDir, float price) =>
    bool found = false
    if array.size(obTopA) > 0                                      // v3.3.7 guard
        for i = 0 to array.size(obTopA) - 1
            if array.get(obActA, i) and not array.get(obMitA, i) and array.get(obDirA, i) == tradeDir
                if price <= array.get(obTopA, i) and price >= array.get(obBotA, i)
                    found := true
                    break
    found
// v3.3.4 ZERO-TRADE FIX: price inside an ACTIVE (unviolated) OB.
inActiveOB(int tradeDir, float price) =>
    bool found = false
    if array.size(obTopA) > 0                                      // v3.3.7 guard
        for i = 0 to array.size(obTopA) - 1
            if array.get(obActA, i) and array.get(obDirA, i) == tradeDir
                if price <= array.get(obTopA, i) and price >= array.get(obBotA, i)
                    found := true
                    break
    found
nearestFVGtext(int dir) =>
    idx = nearestFVG(dir)
    idx < 0 ? "none" : str.tostring(array.get(fvgBotA, idx), format.mintick) + "-" + str.tostring(array.get(fvgTopA, idx), format.mintick) + " (" + str.tostring(math.round(array.get(fvgFillA, idx))) + "%)"
trendTxt(int t) => t == 1 ? "^ BULL" : t == -1 ? "v BEAR" : "- none"
// ----------------- DUAL STRUCTURE (inline state) -------------------
var int   extTrend = 0
var int   intTrend = 0
var float extProtHigh = na
var float extProtLow  = na
var float intProtHigh = na
var float intProtLow  = na
[eH_, eL_] = findProtected(InpExtSwingStrength)
[iH_, iL_] = findProtected(InpIntSwingStrength)
extProtHigh := eH_
extProtLow  := eL_
intProtHigh := iH_
intProtLow  := iL_
bosH = InpBOSUseClose ? close[1] : high[1]
bosL = InpBOSUseClose ? close[1] : low[1]
if not na(extProtHigh) and bosH > extProtHigh
    extTrend := 1
else if not na(extProtLow) and bosL < extProtLow
    extTrend := -1
if not na(intProtHigh) and bosH > intProtHigh
    intTrend := 1
else if not na(intProtLow) and bosL < intProtLow
    intTrend := -1
// ----------------- LIQUIDITY (inline state) ------------------------
var int   sweepConfLong  = 0
var int   sweepConfShort = 0
var string liqStatus = "watching pools"
eqH = detectEqualHighs()
eqL = detectEqualLows()
poolHi = ta.highest(high[2], InpSweepValidBars * 2)
poolLo = ta.lowest(low[2],  InpSweepValidBars * 2)
bsl = na(extProtHigh) ? poolHi : math.max(extProtHigh, poolHi)
bsl := na(eqH) ? bsl : math.max(bsl, eqH)
ssl = na(extProtLow) ? poolLo : math.min(extProtLow, poolLo)
ssl := na(eqL) ? ssl : math.min(ssl, eqL)
sweepBuf = sweepMinDist
if barstate.isconfirmed
    if sweepConfLong  > 0
        sweepConfLong  -= 1
    if sweepConfShort > 0
        sweepConfShort -= 1
    sweptSSL = not na(ssl) and low[1] < ssl - sweepBuf and close[1] > ssl
    reclaimL = not InpRequireReclaim or close[1] > ssl or close[2] > ssl or close[3] > ssl
    sweptBSL = not na(bsl) and high[1] > bsl + sweepBuf and close[1] < bsl
    reclaimS = not InpRequireReclaim or close[1] < bsl or close[2] < bsl or close[3] < bsl
    if sweptSSL and reclaimL
        sweepConfLong  := InpSweepValidBars
        liqStatus := "SSL swept+reclaim"
    else if sweptBSL and reclaimS
        sweepConfShort := InpSweepValidBars
        liqStatus := "BSL swept+reclaim"
    else if sweepConfLong  > 0
        liqStatus := "long armed (" + str.tostring(sweepConfLong) + ")"
    else if sweepConfShort > 0
        liqStatus := "short armed (" + str.tostring(sweepConfShort) + ")"
    else
        liqStatus := "watching pools"
// ----------------- FVG detect / fill / draw (RE10008-guarded) -------
if bar_index >= 3 and barstate.isconfirmed
    if (low[1] - high[3]) >= fvgMinDist
        addFVG(low[1], high[3], 1, bar_index - 2)
    if (low[3] - high[1]) >= fvgMinDist
        addFVG(low[3], high[1], -1, bar_index - 2)
    if array.size(fvgTopA) > 0                                     // v3.3.7 guard: skip empty array (bar-0 array.get fix)
        for i = 0 to array.size(fvgTopA) - 1
            if array.get(fvgActA, i)
                top = array.get(fvgTopA, i)
                bot = array.get(fvgBotA, i)
                span = top - bot
                if span <= 0
                    array.set(fvgActA, i, false)
                else
                    pct = array.get(fvgFillA, i)
                    if array.get(fvgDirA, i) == 1
                        if low[1] < top
                            pct := math.max(pct, 100.0 * (top - math.max(low[1], bot)) / span)
                    else
                        if high[1] > bot
                            pct := math.max(pct, 100.0 * (math.min(high[1], top) - bot) / span)
                    array.set(fvgFillA, i, pct)
                    if pct >= InpFVGFillInvalidate
                        array.set(fvgActA, i, false)
                b = array.get(fvgBoxA, i)
                if not na(b)
                    if array.get(fvgActA, i)
                        box.set_right(b, bar_index)
                    else
                        box.delete(b)
                        array.set(fvgBoxA, i, na)
// ----------------- Order blocks detect / mitigate / draw -----------
if InpUseOrderBlocks and barstate.isconfirmed
    if scoreDisplacement(1, 1) >= InpDispMinScore
        for k = 2 to InpOBScanBack + 1
            if close[k] < open[k]
                addOB(high[k], low[k], 1, bar_index - k)
                break
    if scoreDisplacement(1, -1) >= InpDispMinScore
        for k = 2 to InpOBScanBack + 1
            if close[k] > open[k]
                addOB(high[k], low[k], -1, bar_index - k)
                break
    if array.size(obTopA) > 0                                      // v3.3.7 guard: skip empty array (THE bar-0 crash site)
        for i = 0 to array.size(obTopA) - 1
            if array.get(obActA, i)
                top = array.get(obTopA, i)
                bot = array.get(obBotA, i)
                if array.get(obDirA, i) == 1
                    if low[1] <= top and high[1] >= bot
                        array.set(obMitA, i, true)
                    thru = InpOBMitigateOnClose ? close[1] : low[1]
                    if thru < bot
                        array.set(obActA, i, false)
                else
                    if high[1] >= bot and low[1] <= top
                        array.set(obMitA, i, true)
                    thru = InpOBMitigateOnClose ? close[1] : high[1]
                    if thru > top
                        array.set(obActA, i, false)
                b = array.get(obBoxA, i)
                if not na(b)
                    if array.get(obActA, i)
                        box.set_right(b, bar_index)
                        box.set_border_style(b, array.get(obMitA, i) ? line.style_dotted : line.style_solid)
                    else
                        box.delete(b)
                        array.set(obBoxA, i, na)
// ----------------- Feed PROTECTED internal swings to ICC anchors ---
var float lastDispScore = 0.0
lastDispScore := scoreDisplacement(1, extTrend >= 0 ? 1 : -1)
if InpIntTrendControlsEnt
    if not na(intProtHigh)
        wkLastHi := intProtHigh
    if not na(intProtLow)
        wkLastLo := intProtLow
// ============================ SWING RAYS ============================
phSwing = ta.pivothigh(swingLen, swingLen)
plSwing = ta.pivotlow (swingLen, swingLen)
var line[] swLines = array.new<line>()
xSwingLeft = bar_index[swingLen]
hiSwing    = high[swingLen]
loSwing    = low[swingLen]
f_pushSwing(int x1, float px, color col) =>
    ln = line.new(x1, px, bar_index, px, color = col, width = 2, extend = extend.right, style = line.style_solid)
    array.push(swLines, ln)
    while array.size(swLines) > maxSwings * 2
        line.delete(array.shift(swLines))
    true
if showSwings and not na(phSwing)
    f_pushSwing(xSwingLeft, hiSwing, colHigh)
if showSwings and not na(plSwing)
    f_pushSwing(xSwingLeft, loSwing, colLow)
// ============================ S/R CLUSTER STORE =====================
var float[] srPrice   = array.new_float()
var int[]   srCount   = array.new_int()
var int[]   srBirthMs = array.new_int()
var int[]   srBirthSes= array.new_int()
var int[]   srBirthBar= array.new_int()
var bool[]  srIsRes   = array.new_bool()
var bool[]  srDrawn   = array.new_bool()
var bool[]  srBroken  = array.new_bool()
var bool[]  srRetested= array.new_bool()
var bool[]  srArmed   = array.new_bool()
var int[]   srArmBar  = array.new_int()
var line[]  srLine    = array.new<line>()
var box[]   srBox     = array.new<box>()
var label[] srLbl     = array.new<label>()
f_srExpired(i) =>
    exp = false
    if srDurMode == "Calendar Days"
        exp := (time - array.get(srBirthMs, i)) >= srDurN * 86400000
    else
        exp := (sessCount - array.get(srBirthSes, i)) >= srDurN
    exp
f_srRemove(i) =>
    ln = array.get(srLine, i)
    if not na(ln)
        line.delete(ln)
    bx = array.get(srBox, i)
    if not na(bx)
        box.delete(bx)
    lb = array.get(srLbl, i)
    if not na(lb)
        label.delete(lb)
    array.remove(srPrice, i)
    array.remove(srCount, i)
    array.remove(srBirthMs, i)
    array.remove(srBirthSes, i)
    array.remove(srBirthBar, i)
    array.remove(srIsRes, i)
    array.remove(srDrawn, i)
    array.remove(srBroken, i)
    array.remove(srRetested, i)
    array.remove(srArmed, i)
    array.remove(srArmBar, i)
    array.remove(srLine, i)
    array.remove(srBox, i)
    array.remove(srLbl, i)
    true
f_srLabelText(isRes, cnt, broken) =>
    pre = broken ? "x " : ""
    pre + (isRes ? "R x" : "S x") + str.tostring(cnt)
f_srDraw(i) =>
    p     = array.get(srPrice, i)
    isRes = array.get(srIsRes, i)
    col   = isRes ? srColRes : srColSup
    bBar  = array.get(srBirthBar, i)
    if srUseZone
        bx = box.new(bBar, p + srTol / 2, bar_index, p - srTol / 2, border_color = color.new(col, srFillTransp), bgcolor = color.new(col, srFillTransp))
        array.set(srBox, i, bx)
    else
        ln = line.new(bBar, p, bar_index, p, color = color.new(col, srFillTransp), width = 2, style = line.style_solid)
        array.set(srLine, i, ln)
    if srShowCnt
        lblStyle = isRes ? label.style_label_down : label.style_label_up
        lb = label.new(bar_index, p, f_srLabelText(isRes, array.get(srCount, i), false), style = lblStyle, color = color.new(col, srFillTransp), textcolor = color.white, size = size.tiny)
        array.set(srLbl, i, lb)
    true
f_srBreak(i) =>
    if brkMode == "Delete"
        f_srRemove(i)
    else
        array.set(srBroken, i, true)
        ln = array.get(srLine, i)
        if not na(ln)
            line.set_color(ln, color.new(brkColor, srFillTransp))
            line.set_style(ln, line.style_dashed)
        bx = array.get(srBox, i)
        if not na(bx)
            box.set_border_color(bx, color.new(brkColor, srFillTransp))
            box.set_bgcolor(bx, color.new(brkColor, srFillTransp))
        lb = array.get(srLbl, i)
        if not na(lb)
            isRes = array.get(srIsRes, i)
            label.set_color(lb, color.new(brkColor, srFillTransp))
            label.set_text(lb, f_srLabelText(isRes, array.get(srCount, i), true))
    true   // CE10235-safe: unified return so both branches yield bool
// ============================ S/R ENGINE (confirmed bars) ===========
var bool  retestBuySig     = false
var bool  retestSellSig    = false
var float retestSigLevel   = na
retestBuySig    := false
retestSellSig   := false
if barstate.isconfirmed and srShow
    c = close
    if array.size(srPrice) > 0
        for i = array.size(srPrice) - 1 to 0
            if f_srExpired(i)
                f_srRemove(i)
    if array.size(srPrice) > 0
        for i = array.size(srPrice) - 1 to 0
            if array.get(srDrawn, i) and not array.get(srBroken, i)
                lvl   = array.get(srPrice, i)
                isRes = array.get(srIsRes, i)
                brokeUp   = isRes and c > lvl + brkBuf
                brokeDown = (not isRes) and c < lvl - brkBuf
                if brokeUp or brokeDown
                    f_srBreak(i)
    if brkMode == "Gray Out" and array.size(srPrice) > 0
        for i = array.size(srPrice) - 1 to 0
            if array.get(srBroken, i) and not array.get(srRetested, i)
                lvl   = array.get(srPrice, i)
                isRes = array.get(srIsRes, i)
                retRes = isRes and low <= lvl + brkBuf and close >= lvl - brkBuf
                retSup = (not isRes) and high >= lvl - brkBuf and close <= lvl + brkBuf
                if retRes or retSup
                    array.set(srRetested, i, true)
                    array.set(srArmed, i, true)
                    array.set(srArmBar, i, bar_index)
    if useRetest and array.size(srPrice) > 0
        for i = array.size(srPrice) - 1 to 0
            if array.get(srArmed, i)
                lvl    = array.get(srPrice, i)
                isRes  = array.get(srIsRes, i)
                armAge = bar_index - array.get(srArmBar, i)
                if armAge > retestArmBars
                    array.set(srArmed, i, false)
                else
                    canCheck = retestSepBar ? (armAge >= 1) : (armAge >= 0)
                    if canCheck
                        confBuy  = isRes and close > lvl + confBuf
                        confSell = (not isRes) and close < lvl - confBuf
                        if confBuy
                            array.set(srArmed, i, false)
                            retestBuySig  := true
                            retestSigLevel:= lvl
                        else if confSell
                            array.set(srArmed, i, false)
                            retestSellSig := true
                            retestSigLevel:= lvl
    matched = false
    if array.size(srPrice) > 0
        for i = 0 to array.size(srPrice) - 1
            if not array.get(srBroken, i) and math.abs(c - array.get(srPrice, i)) <= srTol
                nc = array.get(srCount, i) + 1
                np = (array.get(srPrice, i) * array.get(srCount, i) + c) / nc
                array.set(srCount, i, nc)
                array.set(srPrice, i, np)
                matched := true
                alreadyDrawn = array.get(srDrawn, i)
                if nc == srMinTouch and not alreadyDrawn
                    array.set(srDrawn, i, true)
                    array.set(srIsRes, i, np >= srRef)
                    f_srDraw(i)
                else if nc > srMinTouch and alreadyDrawn and srShowCnt
                    lb = array.get(srLbl, i)
                    if not na(lb)
                        isRes = array.get(srIsRes, i)
                        label.set_text(lb, f_srLabelText(isRes, nc, false))
                        label.set_xy(lb, bar_index, np)
                break
    if not matched
        array.push(srPrice, c)
        array.push(srCount, 1)
        array.push(srBirthMs, time)
        array.push(srBirthSes, sessCount)
        array.push(srBirthBar, bar_index)
        array.push(srIsRes, false)
        array.push(srDrawn, false)
        array.push(srBroken, false)
        array.push(srRetested, false)
        array.push(srArmed, false)
        array.push(srArmBar, 0)
        array.push(srLine, na)
        array.push(srBox, na)
        array.push(srLbl, na)
        if array.size(srPrice) > 60
            f_srRemove(0)
if srShow and array.size(srPrice) > 0
    for i = 0 to array.size(srPrice) - 1
        if array.get(srDrawn, i) and not array.get(srBroken, i)
            ln = array.get(srLine, i)
            if not na(ln)
                line.set_x2(ln, bar_index)
            bx = array.get(srBox, i)
            if not na(bx)
                box.set_right(bx, bar_index)
// =====================================================================
//  ICC PULLBACK ENGINE  (Indication -> Correction -> Continuation)
// =====================================================================
var int   iccPhase   = 0
var int   iccDir     = 0
var float indLevel   = na
var float indExtreme = na
var float corrExtreme= na
var int   iccStartBar= 0
var bool  iccBuySig  = false
var bool  iccSellSig = false
var float iccSigSL   = na
iccBuySig  := false
iccSellSig := false
iccSigSL   := na
dataReady = not na(m15c1) and not na(wkH1c) and not na(wkL1c)
if useICC and barstate.isconfirmed and dataReady
    if iccPhase != 0 and iccDir != 0 and htf != 0 and htf != iccDir
        iccPhase := 0
        iccDir := 0
    if iccPhase != 0 and (bar_index - iccStartBar) > iccExpiry
        iccPhase := 0
        iccDir := 0
    if htf == 1
        if iccPhase == 0
            extOKb   = not InpExtTrendControlsDir or extTrend >= 0
            sweepOKb = not InpRequireSweep        or sweepConfLong > 0
            dispOKb  = not InpRejectWeakBreaks    or scoreDisplacement(1, 1) >= InpDispMinScore
            if not na(wkLastHi) and m15c1 > wkLastHi and extOKb and sweepOKb and dispOKb
                iccPhase   := 1
                iccDir     := 1
                indLevel   := wkLastHi
                indExtreme := math.max(wkH1c, m15c1)
                corrExtreme:= wkL1c
                iccStartBar:= bar_index
        else if iccPhase == 1 and iccDir == 1
            indExtreme := math.max(indExtreme, wkH1c)
            leg = indExtreme - indLevel
            if leg > 0
                disc  = indExtreme - leg * corrRetMin
                inval = indExtreme - leg * corrRetMax
                if wkL1c <= inval
                    iccPhase := 0
                    iccDir := 0
                else if wkL1c <= disc
                    iccPhase    := 2
                    corrExtreme := wkL1c
        else if iccPhase == 2 and iccDir == 1
            corrExtreme := math.min(corrExtreme, wkL1c)
            leg   = indExtreme - indLevel
            inval = leg > 0 ? indExtreme - leg * corrRetMax : 0.0
            discB = leg > 0 ? indExtreme - leg * corrRetMin : corrExtreme   // v3.3.8 shallow edge of discount band
            if leg > 0 and wkL1c <= inval
                iccPhase := 0
                iccDir := 0
            else if not na(m15h2) and m15c1 > m15h2 and (not InpRequireFVGpullback or fvgContainOK(1, corrExtreme, discB)) and (not InpRequireOB or not InpUseOrderBlocks or inActiveOB(1, corrExtreme))
                iccBuySig := true
                iccSigSL  := corrExtreme - iccSLbuf
                iccPhase := 0
                iccDir := 0
    else if htf == -1
        if iccPhase == 0
            extOKs   = not InpExtTrendControlsDir or extTrend <= 0
            sweepOKs = not InpRequireSweep        or sweepConfShort > 0
            dispOKs  = not InpRejectWeakBreaks    or scoreDisplacement(1, -1) >= InpDispMinScore
            if not na(wkLastLo) and m15c1 < wkLastLo and extOKs and sweepOKs and dispOKs
                iccPhase   := 1
                iccDir     := -1
                indLevel   := wkLastLo
                indExtreme := math.min(wkL1c, m15c1)
                corrExtreme:= wkH1c
                iccStartBar:= bar_index
        else if iccPhase == 1 and iccDir == -1
            indExtreme := math.min(indExtreme, wkL1c)
            leg = indLevel - indExtreme
            if leg > 0
                prem  = indExtreme + leg * corrRetMin
                inval = indExtreme + leg * corrRetMax
                if wkH1c >= inval
                    iccPhase := 0
                    iccDir := 0
                else if wkH1c >= prem
                    iccPhase    := 2
                    corrExtreme := wkH1c
        else if iccPhase == 2 and iccDir == -1
            corrExtreme := math.max(corrExtreme, wkH1c)
            leg   = indLevel - indExtreme
            inval = leg > 0 ? indExtreme + leg * corrRetMax : 0.0
            premB = leg > 0 ? indExtreme + leg * corrRetMin : corrExtreme   // v3.3.8 shallow edge of premium band
            if leg > 0 and wkH1c >= inval
                iccPhase := 0
                iccDir := 0
            else if not na(m15l2) and m15c1 < m15l2 and (not InpRequireFVGpullback or fvgContainOK(-1, corrExtreme, premB)) and (not InpRequireOB or not InpUseOrderBlocks or inActiveOB(-1, corrExtreme))
                iccSellSig := true
                iccSigSL   := corrExtreme + iccSLbuf
                iccPhase := 0
                iccDir := 0
// ============================ CASCADE BREAKOUT (v1, optional) ========
buyContinuation  = useCascade and alignBull and not na(wkLastHi) and m15c1 > wkLastHi
sellContinuation = useCascade and alignBear and not na(wkLastLo) and m15c1 < wkLastLo
cascBuySig  = buyContinuation  and not buyContinuation[1]
cascSellSig = sellContinuation and not sellContinuation[1]
// ============================ COMBINED SIGNALS ======================
buySig  = iccBuySig  or retestBuySig  or cascBuySig
sellSig = iccSellSig or retestSellSig or cascSellSig
// =====================================================================
//  v2.2 STRUCTURAL TAKE-PROFIT (Sci: "target the previous high")
// =====================================================================
tpHiFallback = request.security(syminfo.tickerid, workTF, ta.highest(high, tpLookback), lookahead = barmerge.lookahead_off)
tpLoFallback = request.security(syminfo.tickerid, workTF, ta.lowest(low,  tpLookback), lookahead = barmerge.lookahead_off)
var float g_lastTP       = na
var bool  g_lastTPstruct = false
f_structTP(int dir, float entryPx) =>
    best = 0.0
    if array.size(srPrice) > 0
        for i = 0 to array.size(srPrice) - 1
            if array.get(srDrawn, i) and not array.get(srBroken, i)
                lvl = array.get(srPrice, i)
                if dir > 0 and lvl > entryPx
                    best := (best == 0.0 or lvl < best) ? lvl : best
                if dir < 0 and lvl < entryPx
                    best := (best == 0.0 or lvl > best) ? lvl : best
    if best == 0.0
        if dir > 0
            best := (not na(tpHiFallback) and tpHiFallback > entryPx) ? tpHiFallback : 0.0
        else
            best := (not na(tpLoFallback) and tpLoFallback > 0.0 and tpLoFallback < entryPx) ? tpLoFallback : 0.0
    best
f_tp(int dir, float entryPx, float d) =>
    float tpx = dir > 0 ? entryPx + d * rrRatio : entryPx - d * rrRatio
    bool  us  = false
    if tpMode == "Structural"
        lvl = f_structTP(dir, entryPx)
        if lvl > 0.0
            dist = dir > 0 ? (lvl - entryPx) : (entryPx - lvl)
            if dist >= syminfo.mintick * 10 and dist >= d * tpMinRR
                tpx := lvl
                us  := true
    [tpx, us]
// =====================================================================
//  SMART STOP + ORDER ROUTING (strategy.entry / strategy.exit)
// =====================================================================
f_atrStop() =>
    na(atrVal) ? slBufP : atrVal * atrMult
f_longStopDist(anchor) =>
    structDist = math.max(0.0, close - anchor) + slBufP
    atrStop    = f_atrStop()
    d = slMethod == "Structural" ? structDist : slMethod == "ATR" ? atrStop : math.max(structDist, atrStop)
    math.max(d, syminfo.mintick * 10)
f_shortStopDist(anchor) =>
    structDist = math.max(0.0, anchor - close) + slBufP
    atrStop    = f_atrStop()
    d = slMethod == "Structural" ? structDist : slMethod == "ATR" ? atrStop : math.max(structDist, atrStop)
    math.max(d, syminfo.mintick * 10)
flat    = strategy.position_size == 0
isLong  = strategy.position_size > 0
isShort = strategy.position_size < 0
if closeOnOpp and isLong and sellSig
    strategy.close("Long", comment = "EXIT LONG")
if closeOnOpp and isShort and buySig
    strategy.close("Short", comment = "EXIT SHORT")
canEnter = flat and inSession and barstate.isconfirmed
var float entrySL = na
var float entryTP = na
if canEnter
    if iccBuySig
        anchor = not na(iccSigSL) ? iccSigSL : wkLastLo
        d  = f_longStopDist(anchor)
        sl = close - d
        [tp, tpUS] = f_tp(1, close, d)
        strategy.entry("Long", strategy.long, comment = "ICC BUY")
        entrySL := sl
        entryTP := tp
        g_lastTP := tp
        g_lastTPstruct := tpUS
    else if iccSellSig
        anchor = not na(iccSigSL) ? iccSigSL : wkLastHi
        d  = f_shortStopDist(anchor)
        sl = close + d
        [tp, tpUS] = f_tp(-1, close, d)
        strategy.entry("Short", strategy.short, comment = "ICC SELL")
        entrySL := sl
        entryTP := tp
        g_lastTP := tp
        g_lastTPstruct := tpUS
    else if retestBuySig
        anchor = retestSigLevel - slBuf
        d  = f_longStopDist(anchor)
        sl = close - d
        [tp, tpUS] = f_tp(1, close, d)
        strategy.entry("Long", strategy.long, comment = "RETEST BUY")
        entrySL := sl
        entryTP := tp
        g_lastTP := tp
        g_lastTPstruct := tpUS
    else if retestSellSig
        anchor = retestSigLevel + slBuf
        d  = f_shortStopDist(anchor)
        sl = close + d
        [tp, tpUS] = f_tp(-1, close, d)
        strategy.entry("Short", strategy.short, comment = "RETEST SELL")
        entrySL := sl
        entryTP := tp
        g_lastTP := tp
        g_lastTPstruct := tpUS
    else if cascBuySig
        d  = f_longStopDist(wkLastLo)
        sl = close - d
        [tp, tpUS] = f_tp(1, close, d)
        strategy.entry("Long", strategy.long, comment = "BUY BREAKOUT")
        entrySL := sl
        entryTP := tp
        g_lastTP := tp
        g_lastTPstruct := tpUS
    else if cascSellSig
        d  = f_shortStopDist(wkLastHi)
        sl = close + d
        [tp, tpUS] = f_tp(-1, close, d)
        strategy.entry("Short", strategy.short, comment = "SELL BREAKOUT")
        entrySL := sl
        entryTP := tp
        g_lastTP := tp
        g_lastTPstruct := tpUS
// =====================================================================
//  EXITS: fixed SL/TP + optional break-even + trailing
//  v3.3.6: trail_offset uses the effective trail distance (ATR-auto or
//  fixed) converted to ticks: trailStepD / mintick.
// =====================================================================
if isLong and not na(entrySL)
    curSL = entrySL
    if useBE and (high - strategy.position_avg_price) >= beAt
        curSL := math.max(curSL, strategy.position_avg_price + beLock)
    strategy.exit("XL", "Long", stop = curSL, limit = entryTP,
         trail_price  = useTrail ? strategy.position_avg_price + trailStart : na,
         trail_offset = useTrail ? trailStepD / syminfo.mintick : na)
if isShort and not na(entrySL)
    curSL = entrySL
    if useBE and (strategy.position_avg_price - low) >= beAt
        curSL := math.min(curSL, strategy.position_avg_price - beLock)
    strategy.exit("XS", "Short", stop = curSL, limit = entryTP,
         trail_price  = useTrail ? strategy.position_avg_price - trailStart : na,
         trail_offset = useTrail ? trailStepD / syminfo.mintick : na)
// =====================================================================
//  v3.3.9 EXIT LABELS — label every CLOSED trade on the chart
//  ------------------------------------------------------------------
//  Additive/visual only. On each confirmed bar, if strategy.closedtrades
//  grew, label each newly-closed trade at its exit bar+price. exit_id
//  carries the close reason: "XL"/"XS" = the SL/TP/trailing exit orders;
//  "EXIT LONG"/"EXIT SHORT" = the opposite-signal strategy.close comment.
//  Colour = win/loss by realised profit. No trading logic is touched.
// =====================================================================
var int lastClosedCount = 0
if showExitLabels and barstate.isconfirmed and strategy.closedtrades > lastClosedCount
    for ti = lastClosedCount to strategy.closedtrades - 1
        exBar   = strategy.closedtrades.exit_bar_index(ti)
        exPx    = strategy.closedtrades.exit_price(ti)
        exId    = strategy.closedtrades.exit_id(ti)
        exProf  = strategy.closedtrades.profit(ti)
        exSize  = strategy.closedtrades.size(ti)          // >0 was long, <0 was short
        if not na(exBar) and not na(exPx)
            win     = exProf >= 0
            wasLong = exSize > 0
            reason  = na(exId) ? "EXIT" : exId
            txt     = "x " + reason + (exitLblShowProfit ? "\n" + str.tostring(exProf, format.mintick) : "")
            // anchor AT the exit price; long-exit label points down (sits above),
            // short-exit label points up (sits below) so it never hides the bar.
            stl     = wasLong ? label.style_label_down : label.style_label_up
            label.new(exBar, exPx, txt, xloc = xloc.bar_index, yloc = yloc.price, style = stl, color = win ? exitLblWinCol : exitLblLossCol, textcolor = color.white, size = size.tiny)
    lastClosedCount := strategy.closedtrades
// =====================================================================
//  ENTRY MARKERS + ICC PHASE LABELS + ALERTS
// =====================================================================
plotshape(iccBuySig,    title="ICC BUY",   style = shape.triangleup,   location = location.belowbar, color = color.new(color.lime,0),   size = size.small, text = "ICC^")
plotshape(iccSellSig,   title="ICC SELL",  style = shape.triangledown, location = location.abovebar, color = color.new(color.red, 0),   size = size.small, text = "ICCv")
plotshape(retestBuySig, title="RETEST BUY",  style = shape.labelup,   location = location.belowbar, color = color.new(color.green, 0), textcolor = color.white, size = size.tiny, text = "RT^")
plotshape(retestSellSig,title="RETEST SELL", style = shape.labeldown, location = location.abovebar, color = color.new(color.maroon,0), textcolor = color.white, size = size.tiny, text = "RTv")
plotshape(cascBuySig,   title="BREAKOUT BUY",  style = shape.diamond, location = location.belowbar, color = color.new(color.aqua,0),   size = size.tiny, text = "BO^")
plotshape(cascSellSig,  title="BREAKOUT SELL", style = shape.diamond, location = location.abovebar, color = color.new(color.fuchsia,0),size = size.tiny, text = "BOv")
indFired = iccPhase == 1 and iccPhase[1] != 1
corFired = iccPhase == 2 and iccPhase[1] != 2
if showICClabels and indFired
    label.new(bar_index, low, "IND " + (iccDir == 1 ? "▲" : "▼"), style = label.style_label_up, color = color.new(color.blue, 30), textcolor = color.white, size = size.tiny)
if showICClabels and corFired
    label.new(bar_index, high, "COR", style = label.style_label_down, color = color.new(color.orange, 30), textcolor = color.white, size = size.tiny)
alertcondition(iccBuySig,    "ICC BUY (continuation)",  '{"symbol":"{{ticker}}","tf":"{{interval}}","side":"BUY","type":"icc","price":{{close}},"strategy":"ICC-Sci-Strat-v3.3.9"}')
alertcondition(iccSellSig,   "ICC SELL (continuation)", '{"symbol":"{{ticker}}","tf":"{{interval}}","side":"SELL","type":"icc","price":{{close}},"strategy":"ICC-Sci-Strat-v3.3.9"}')
alertcondition(retestBuySig, "ICC RETEST BUY",  '{"symbol":"{{ticker}}","tf":"{{interval}}","side":"BUY","type":"retest","price":{{close}},"strategy":"ICC-Sci-Strat-v3.3.9"}')
alertcondition(retestSellSig,"ICC RETEST SELL", '{"symbol":"{{ticker}}","tf":"{{interval}}","side":"SELL","type":"retest","price":{{close}},"strategy":"ICC-Sci-Strat-v3.3.9"}')
// =====================================================================
//  CASCADE + ICC + SMC DASHBOARD
// =====================================================================
var table dash = table.new(position.top_right, 2, 23, border_width = 1)
f_biasTxt(b) =>
    b == 1 ? "^ BULL" : b == -1 ? "v BEAR" : "- flat"
f_biasCol(b) =>
    bullCol = color.new(color.green, 70)
    bearCol = color.new(color.red,   70)
    flatCol = color.new(color.gray,  70)
    b == 1 ? bullCol : b == -1 ? bearCol : flatCol
f_phaseTxt(p) =>
    p == 1 ? "IND" : p == 2 ? "COR" : "---"
f_srActive() =>
    cnt = 0
    if array.size(srDrawn) > 0
        for i = 0 to array.size(srDrawn) - 1
            if array.get(srDrawn, i) and not array.get(srBroken, i)
                cnt += 1
    cnt
f_srArmed() =>
    cnt = 0
    if array.size(srArmed) > 0
        for i = 0 to array.size(srArmed) - 1
            if array.get(srArmed, i)
                cnt += 1
    cnt
if showDash and barstate.islast
    table.cell(dash, 0, 0, "TF",   bgcolor=color.new(color.black,70), text_color=color.white)
    table.cell(dash, 1, 0, "Bias", bgcolor=color.new(color.black,70), text_color=color.white)
    table.cell(dash, 0, 1, biasTF, text_color=color.white)
    table.cell(dash, 1, 1, f_biasTxt(biasD1),  bgcolor=f_biasCol(biasD1))
    table.cell(dash, 0, 2, midTF,  text_color=color.white)
    table.cell(dash, 1, 2, f_biasTxt(biasH4),  bgcolor=f_biasCol(biasH4))
    table.cell(dash, 0, 3, workTF, text_color=color.white)
    table.cell(dash, 1, 3, f_biasTxt(biasH1),  bgcolor=f_biasCol(biasH1))
    table.cell(dash, 0, 4, trigTF, text_color=color.white)
    table.cell(dash, 1, 4, f_biasTxt(biasM15), bgcolor=f_biasCol(biasM15))
    table.cell(dash, 0, 5, "HTF filter", text_color=color.white)
    table.cell(dash, 1, 5, f_biasTxt(htf), bgcolor=f_biasCol(htf))
    table.cell(dash, 0, 6, "HTF score", text_color=color.white)
    table.cell(dash, 1, 6, str.tostring(htfScore, "#.##") + " (min " + str.tostring(htfMinConv, "#.##") + ")", text_color=color.white)
    table.cell(dash, 0, 7, "ICC phase", text_color=color.white)
    iccBg = iccPhase == 2 ? color.new(color.orange,40) : iccPhase == 1 ? color.new(color.blue,40) : color.new(color.gray,60)
    table.cell(dash, 1, 7, f_phaseTxt(iccPhase) + " (" + str.tostring(iccDir) + ")", bgcolor=iccBg, text_color=color.white)
    posTxt = isLong ? "LONG" : isShort ? "SHORT" : "flat"
    table.cell(dash, 0, 8, "Position", text_color=color.white)
    table.cell(dash, 1, 8, posTxt, text_color=color.white)
    table.cell(dash, 0, 9, "S/R (armed)", text_color=color.white)
    table.cell(dash, 1, 9, str.tostring(f_srActive()) + " (" + str.tostring(f_srArmed()) + ")", text_color=color.white)
    extC = extTrend == 1 ? color.new(color.green,50) : extTrend == -1 ? color.new(color.red,50) : color.new(color.gray,60)
    intC = intTrend == 1 ? color.new(color.green,50) : intTrend == -1 ? color.new(color.red,50) : color.new(color.gray,60)
    table.cell(dash, 0, 10, "External trend", text_color=color.white, bgcolor=color.new(color.black,80))
    table.cell(dash, 1, 10, trendTxt(extTrend), bgcolor=extC, text_color=color.white)
    table.cell(dash, 0, 11, "Internal trend", text_color=color.white, bgcolor=color.new(color.black,80))
    table.cell(dash, 1, 11, trendTxt(intTrend), bgcolor=intC, text_color=color.white)
    table.cell(dash, 0, 12, "Liquidity", text_color=color.white)
    table.cell(dash, 1, 12, liqStatus, text_color=color.white)
    table.cell(dash, 0, 13, "Displacement", text_color=color.white)
    table.cell(dash, 1, 13, str.tostring(math.round(lastDispScore)) + "/100", text_color=color.white)
    table.cell(dash, 0, 14, "Nearest Bull FVG", text_color=color.white)
    table.cell(dash, 1, 14, nearestFVGtext(1), text_color=color.white)
    table.cell(dash, 0, 15, "Nearest Bear FVG", text_color=color.white)
    table.cell(dash, 1, 15, nearestFVGtext(-1), text_color=color.white)
    table.cell(dash, 0, 16, "Trades", text_color=color.white)
    table.cell(dash, 1, 16, str.tostring(strategy.closedtrades), text_color=color.white)
    table.cell(dash, 0, 17, "TP mode", text_color=color.white)
    tpTxt = (tpMode == "Structural") ? "STRUCT" : "FIXED_RR"
    tpTxt := na(g_lastTP) ? tpTxt : tpTxt + " " + str.tostring(g_lastTP) + (g_lastTPstruct ? " [s]" : " [rr]")
    tpBg  = (tpMode == "Structural") ? color.new(color.teal,40) : color.new(color.gray,60)
    table.cell(dash, 1, 17, tpTxt, bgcolor=tpBg, text_color=color.white)
    table.cell(dash, 0, 18, "Asset / pip", text_color=color.white, bgcolor=color.new(color.black,80))
    table.cell(dash, 1, 18, assetClass + " / " + str.tostring(pip, format.mintick), text_color=color.white)
    table.cell(dash, 0, 19, "Auto-scale", text_color=color.white)
    table.cell(dash, 1, 19, autoScaleByAsset ? ("ON x" + str.tostring(assetMult, "#.#")) : "OFF", text_color=color.white)
    // v3.3.6: pip-mode readout — ATR-auto vs fixed + the live S/R tol used
    table.cell(dash, 0, 20, "Pip mode", text_color=color.white, bgcolor=color.new(color.black,80))
    table.cell(dash, 1, 20, (useATRauto ? "ATR-AUTO" : "FIXED") + " srTol=" + str.tostring(srTol, format.mintick), text_color=color.white)
    // v3.3.8: FVG-containment mode readout — RELAXED (tol/band) vs STRICT point-in-gap
    fvgCtxt = relaxFVGcontain ? ("RELAX tol=" + str.tostring(fvgContainTol, format.mintick) + (useFVGband ? "+band" : "")) : "STRICT"
    fvgCbg  = relaxFVGcontain ? color.new(color.teal, 40) : color.new(color.gray, 60)
    table.cell(dash, 0, 21, "FVG contain", text_color=color.white, bgcolor=color.new(color.black,80))
    table.cell(dash, 1, 21, fvgCtxt, bgcolor=fvgCbg, text_color=color.white)
    // v3.3.9: exit-label mode readout — ON (win/loss labels at each close) vs OFF
    exLtxt = showExitLabels ? ("ON" + (exitLblShowProfit ? "+P&L" : "")) : "OFF"
    exLbg  = showExitLabels ? color.new(color.teal, 40) : color.new(color.gray, 60)
    table.cell(dash, 0, 22, "Exit lbls", text_color=color.white, bgcolor=color.new(color.black,80))
    table.cell(dash, 1, 22, exLtxt, bgcolor=exLbg, text_color=color.white)
