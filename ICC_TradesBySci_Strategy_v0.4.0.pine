CFG_ltfRecentBars   = input.int(20, "LTF reversal remains valid (chart bars) [ENG]", minval = 1, maxval = 200, group = G_STRUCTURE)
CFG_maxChaseAtr     = input.float(0.50, "Maximum entry drift from reference (ATR) [ENG]", minval = 0.05, maxval = 5.0, step = 0.05, group = G_STRUCTURE)

CFG_readyTimeout = input.int(96, "Correction-ready timeout (chart bars) [ENG]", minval = 1, maxval = 200, group = G_STRUCTURE)

CFG_blockEquals = input.bool(false, "Optional historical equal-extreme veto [ENG]", group = G_STRUCTURE)
CFG_markupAgeHours = input.int(120, "Maximum markup origin age (elapsed hours) [ENG]", minval = 12, maxval = 720, group = G_STRUCTURE)
