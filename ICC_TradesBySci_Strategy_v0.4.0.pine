CFG_nestedTimeout = input.int(96, "Maximum unfinished entry setup (chart bars) [ENG]", minval=4, maxval=500, group=G_STRUCTURE)
CFG_useChase = input.bool(false, "Enable entry-distance filter [ENG]", group=G_STRUCTURE)
