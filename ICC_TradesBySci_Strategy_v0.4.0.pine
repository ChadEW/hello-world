//@version=6
// =================================================================================================
// ICC_TradesBySci_Strategy_v0.4.0.pine
// TYPE: TRADING STRATEGY. This is not an indicator.
// PURPOSE: Transcript-grounded ICC research approximation, not discretionary execution parity.
// STATUS: Static audit only; this release has not been compiled or backtested here.
// HTF: Native-context [1] offsets with lookahead_on. Confirmed chart-close execution only.
// ENTRY: Arm on confirmed correction; nested reversal/pullback/second reaction identifies entry.
//        Do not require a completed HTF continuation or a break of the nested impulse extreme.
// LEVELS: HTF body levels by default; chart HL/LH wick supplies initial protective stop.
// TARGETS: Soft objective by default; optional rejection partial and hard limit are [ENG].
// FILTERS: Larger-TF veto, equal-memory veto, ATR/depth thresholds are optional [ENG].
// ML: v4 feature contract; manual identity checks are not training provenance. No model supplied.
// LIMITS: Confirmed-bar delay differs from intrabar examples. Pivots are proxies for visual swings.
//         Session windows do not measure volume. Gaps, slippage and feed revisions remain risks.
//         Positive-price linear point-value instruments only; no live execution guarantee.
// =================================================================================================
strategy(
     title = "ICC TradesBySci Strategy v0.4.0",
     shorttitle = "ICC TBS STR v0.4.0",
     overlay = true,
     pyramiding = 0,
     initial_capital = 100000,
     currency = currency.USD,
     commission_type = strategy.commission.percent,
     commission_value = 0.01,
     slippage = 1,
     calc_on_order_fills = false,
     calc_on_every_tick = false,
     process_orders_on_close = true,
     margin_long = 100,
     margin_short = 100,
     max_bars_back = 5000,
     max_labels_count = 500,
     max_lines_count = 500,
     max_boxes_count = 100)

// =================================================================================================
// VERSION CONTRACTS
// =================================================================================================
const string STRATEGY_VERSION = "ICC_STRATEGY_v0.4.0"
const string METHOD_VERSION   = "ICC_METHOD_v1.3"
const string FEATURE_VERSION  = "ICC_FEATURES_v4_16"
const string ALERT_SCHEMA     = "icc_setup_v4"

// =================================================================================================
// ENUMS AND CONSTANTS
// =================================================================================================
const int DIR_NONE  = 0
const int DIR_LONG  = 1
const int DIR_SHORT = -1

const int ST_NO_TRADE     = 0
const int ST_INDICATION   = 1
const int ST_CORRECTION   = 2
const int ST_CONTINUATION = 3

const int REASON_ACCEPTED      = 0
const int R001_NO_STRUCTURE    = 1
const int R003_CORR_INCOMPLETE = 3
const int R004_NO_LTF_REVERSAL = 4
const int R005_TF_MISALIGN     = 5
const int R006_EQUAL_EXTREMES  = 6
const int R007_OUT_SESSION     = 7
const int R008_STOP_INVALID    = 8
const int R009_TARGET_INVALID  = 9
const int R010_R_TOO_LOW       = 10
const int R011_ENTRY_CHASED    = 11
const int R012_FEATURE_NA      = 12
const int R013_FEATURE_RANGE   = 13
const int R014_MODEL_VERSION   = 14
const int R015_MODEL_THRESHOLD = 15
const int R016_RISK_LOCK       = 16
const int R017_REPAINT_MODE    = 17
const int R018_BUSY = 18
const int R019_EXPIRED = 19
const int R020_MODEL_NOT_READY = 20
const int R021_WRONG_SIDE = 21
const int R022_TARGET_USED = 22
const int R023_SUBMIT_UNOBSERVED = 23

// =================================================================================================
// INPUTS
// =================================================================================================
const string G_TF = "1 - Timeframes and research mode"
CFG_markupTf    = input.timeframe("60", "Markup timeframe [ICC]", group = G_TF)
CFG_biasTf      = input.timeframe("240", "Bias timeframe [ICC]", group = G_TF)
CFG_confirmed = input.bool(true, "Enable confirmed research trading", group = G_TF, tooltip = "OFF disables new entries. HTF data remains confirmed in both settings.")
CFG_useBias     = input.bool(false, "Optional larger-TF trend veto [ENG]", group = G_TF)
CFG_strictMarkup = input.bool(false, "Require pre-existing markup trend [ENG, may exclude reversals]", group = G_TF)
CFG_strictBias  = input.bool(true, "Bias must be established, not undefined [ENG]", group = G_TF)

CFG_minMarkupMinutes = input.int(60, "Minimum markup minutes [PROFILE]", minval=30, maxval=60, group=G_TF)
const string G_STRUCTURE = "2 - Structure and ICC cycle"
CFG_useBodies       = input.bool(true, "Use candle bodies for structural breaks [ICC]", group = G_STRUCTURE)
CFG_markupPivot     = input.int(3, "Markup swing strength [ENG]", minval = 1, maxval = 20, group = G_STRUCTURE)
CFG_entryPivot      = input.int(2, "Entry-TF swing strength [ENG]", minval = 1, maxval = 20, group = G_STRUCTURE)
CFG_equalTolerance  = input.float(0.03, "Equal-extreme tolerance (%) [ENG]", minval = 0.0, step = 0.01, group = G_STRUCTURE)
CFG_equalMemory     = input.int(60, "Equal-extreme memory (markup bars) [ENG]", minval = 1, maxval = 500, group = G_STRUCTURE)
CFG_trendMaxAge     = input.int(200, "Trend-leg maximum age (bars) [ENG]", minval = 10, maxval = 2000, group = G_STRUCTURE)
CFG_correctionPct   = input.float(0.0, "Correction trigger (% of indication leg) [ENG]", minval = 0.0, maxval = 90.0, step = 1.0, group = G_STRUCTURE)
CFG_invalidationPct = input.float(50.0, "Invalidation beyond break level (% of leg) [ENG]", minval = 10.0, maxval = 300.0, step = 5.0, group = G_STRUCTURE)
CFG_minLegAtr       = input.float(0.0, "Minimum indication leg (ATR) [ENG]", minval = 0.0, maxval = 5.0, step = 0.05, group = G_STRUCTURE)
CFG_legTimeout      = input.int(10, "No-leg timeout (markup bars) [ENG]", minval = 2, maxval = 200, group = G_STRUCTURE)
