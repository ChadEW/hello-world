CFG_sessionTz  = input.string("America/New_York", "Session timezone [ENG]", options = ["America/New_York", "Europe/London", "UTC"], group = G_SESSION)

const string G_RISK = "4 - Risk and execution"
RISK_percent          = input.float(0.25, "Risk per trade (% equity) [RISK]", minval = 0.01, maxval = 5.0, step = 0.05, group = G_RISK)
RISK_minR             = input.float(0.0, "Minimum reward/risk to TP1 [ENG]", minval = 0.0, maxval = 10.0, step = 0.25, group = G_RISK)
RISK_stopBufferPct    = input.float(0.05, "Stop buffer beyond correction swing (%) [ENG]", minval = 0.0, maxval = 2.0, step = 0.01, group = G_RISK)
